#!/usr/bin/env bash
# Fast gates before a commit: lint, format, types, and the pytest suite.
#
# Activated by core.hooksPath=.githooks, which is per-clone config. Set it with
# `git config --local core.hooksPath .githooks`, or let ts_install_git_hooks in
# bootstrap/_config.sh do it. Until this was fixed nothing set it anywhere and
# this hook had never run in any clone.
#
# CI (.github/workflows/ci.yml) is authoritative and covers macOS and native
# Debian/Ubuntu, which no local run can. This hook exists to catch things before
# they cost a CI round trip, not to replace it.
#
# Skip a single commit with `git commit --no-verify` if you must.
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
[ -d "$root/tests" ] || exit 0

if ! command -v python3 >/dev/null 2>&1; then
    echo "pre-commit: python3 not found — skipping the gates." >&2
    exit 0
fi

# A missing linter is reported, never silently skipped: a gate you believe is
# running and is not is worse than no gate. Exit status still comes from pytest.
run_optional() {
    local label="$1"; shift
    if python3 -c "import $1" >/dev/null 2>&1; then
        shift
        echo "pre-commit: $label"
        ( cd "$root" && "$@" )
    else
        shift
        echo "pre-commit: $label NOT RUN — install it with: python3 -m pip install --user $1" >&2
    fi
}

run_optional "ruff check"  ruff  python3 -m ruff check tstack tests
run_optional "ruff format" ruff  python3 -m ruff format --check tstack
run_optional "mypy"        mypy  python3 -m mypy

if ! python3 -c 'import pytest' >/dev/null 2>&1; then
    echo "pre-commit: pytest not installed — the suite did NOT run." >&2
    echo "            install it with: python3 -m pip install --user pytest" >&2
    exit 0
fi

echo "pre-commit: pytest"
python3 -m pytest -q "$root/tests"
