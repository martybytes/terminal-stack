#!/usr/bin/env bash
# Fast gates before a commit: lint, format, types, and the pytest suite.
#
# Activated by core.hooksPath=.githooks, which is per-clone config. Set it with
# `git config --local core.hooksPath .githooks`, or let ts_install_git_hooks in
# bootstrap/_config.sh do it. Until this was fixed nothing set it anywhere and
# this hook had never run in any clone.
#
# CI (.github/workflows/ci.yml) is authoritative and covers macOS and native
# Debian/Ubuntu, which no local run can. This hook exists to catch things before
# they cost a CI round trip, not to replace it.
#
# Skip a single commit with `git commit --no-verify` if you must.
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
[ -d "$root/tests" ] || exit 0

if ! command -v python3 >/dev/null 2>&1; then
    echo "pre-commit: python3 not found — skipping the gates." >&2
    exit 0
fi

# A missing linter is reported, never silently skipped: a gate you believe is
# running and is not is worse than no gate. Exit status still comes from pytest.
# shellcheck source=_gates.sh
. "$root/.githooks/_gates.sh"

run_gate() {
    label="$1"; module="$2"; shift 2
    runner="$(gate_runner "$module")"
    if [ -z "$runner" ]; then
        echo "pre-commit: $label NOT RUN - install it (brew install $module, or uv), or: python3 -m pip install --user $module" >&2
        return 0
    fi
    echo "pre-commit: $label"
    ( cd "$root" && $runner "$@" )
}

run_gate "ruff check"  ruff  check tstack tests
run_gate "ruff format" ruff  format --check tstack
run_gate "mypy"        mypy

pytest_runner="$(gate_runner pytest)"
if [ -z "$pytest_runner" ]; then
    echo "pre-commit: pytest unavailable - the suite did NOT run." >&2
    echo "            install uv (it is in the app catalog), or: python3 -m pip install --user pytest" >&2
    exit 0
fi

echo "pre-commit: pytest"
cd "$root"
# tests/ has no __init__.py and its modules import each other, so the repo root
# must be importable. `python3 -m pytest` adds cwd; uvx and a bare binary do not.
if gate_needs_pythonpath "$pytest_runner"; then
    PYTHONPATH="$root${PYTHONPATH:+:$PYTHONPATH}" $pytest_runner -q tests
else
    $pytest_runner -q tests
fi
