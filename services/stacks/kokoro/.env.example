# kokoro — per-machine profile. Copy to .env and uncomment ONE profile below.
#
#   macOS/Linux   cp .env.example .env      (or ../bootstrap.sh --apply)
#   Windows       Copy-Item .env.example .env   (or ..\bootstrap.ps1 -Apply)
#
# .env is gitignored; this file is tracked. Nothing secret belongs in either.
#
#   This machine                                    Profile
#   --------------------------------------------    -------
#   NVIDIA RTX 50-series (Blackwell, sm_120)        A   <- the uncommented default
#   NVIDIA GTX 900 .. RTX 40-series (sm_52..sm_90)  B
#   Any Mac, Apple Silicon or Intel                 C   <- the ONLY option, see below
#   No NVIDIA card, or you don't want TTS on the
#     same GPU as the display                       C

# Compose reads COMPOSE_FILE from this file to decide which compose files to
# merge. The separator defaults to ';' on Windows and ':' elsewhere — pinning it
# to ':' keeps a single .env valid on any host.
COMPOSE_PATH_SEPARATOR=:


# ---------------------------------------------------------------------------
# Profile A — Blackwell / RTX 50-series (sm_120).  <-- default
# CUDA 12.8 build. Required there; the cu126 build crash-loops on first
# synthesis with "no kernel image is available for execution on the device".
# See README.md.
# ---------------------------------------------------------------------------
COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml
KOKORO_IMAGE=ghcr.io/remsky/kokoro-fastapi-gpu:v0.8.0-cu128


# ---------------------------------------------------------------------------
# Profile B — GTX 900-series through RTX 40-series (sm_52 .. sm_90).
# CUDA 12.6 build: the narrower, lighter match for pre-Blackwell cards.
# ---------------------------------------------------------------------------
# COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml
# KOKORO_IMAGE=ghcr.io/remsky/kokoro-fastapi-gpu:v0.8.0-cu126


# ---------------------------------------------------------------------------
# Profile C — CPU. Required on every Mac; optional elsewhere.
#
# Docker Desktop for Mac has no GPU passthrough of any kind — not CUDA, and not
# Metal/MPS. A Linux container on macOS cannot see the Apple GPU under any
# configuration, so this is the only profile that runs there, and A/B fail at
# `docker compose up` with:
#   could not select device driver "nvidia" with capabilities: [[gpu]]
# That loud failure is intended. See README.md, "On a Mac".
#
# Also the right choice on an NVIDIA box when you don't want TTS competing with
# the display GPU.
#
# COMPOSE_FILE must omit the GPU overlay: the nvidia device reservation in
# docker-compose.gpu.yml prevents startup without a working NVIDIA runtime.
#
# v0.8.0 is the SAME upstream release as Profiles A and B, so one version
# number governs all three. Its manifest is multi-arch (linux/amd64 +
# linux/arm64), so Apple Silicon gets the native arm64 image automatically —
# there is no arm64-specific tag to track. Do NOT write ':latest' here: it
# happens to be the same digest as v0.8.0 today, and that is precisely the
# problem (../docs/conventions.md, "Pin exact versions").
# ---------------------------------------------------------------------------
# COMPOSE_FILE=docker-compose.yml
# KOKORO_IMAGE=ghcr.io/remsky/kokoro-fastapi-cpu:v0.8.0


# Host port. The container always listens on 8880 internally; this is the
# loopback-bound host side only.
KOKORO_PORT=8880
