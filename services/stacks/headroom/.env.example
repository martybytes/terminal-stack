# headroom — per-machine settings. Copy to .env and fill in the two secrets.
#
#   macOS/Linux   cp .env.example .env      (or ../bootstrap.sh --apply)
#   Windows       Copy-Item .env.example .env   (or ..\bootstrap.ps1 -Apply)
#
# .env is gitignored; this file is tracked and holds only placeholders.
#
# Unlike agentmemory, which generates its own HMAC inside the container on first
# boot, headroom's two credentials have to exist BEFORE the containers start —
# compose interpolates them, and both are declared required, so the stack fails
# loudly rather than starting unauthenticated. That is deliberate: neither
# service authenticates by default, and the proxy relays to your LLM provider.

# --- secrets: generate these, do not invent them by hand ----------------------
# Both are one-liners. Run each and paste the result:
#
#   openssl rand -hex 32
#
# HEADROOM_PROXY_TOKEN guards the proxy's /v1/* data plane. Without it the
# loopback bind is the ONLY thing standing between any local process and a
# relay to your LLM provider — and it is what makes publishing the port beyond
# loopback merely unwise rather than catastrophic.
HEADROOM_PROXY_TOKEN=replace-me-with-openssl-rand-hex-32

# NEO4J_PASSWORD is the graph store's password. It is used twice — as the
# proxy's NEO4J_PASSWORD and inside neo4j's own NEO4J_AUTH — so it is defined
# once here. Neo4j refuses to start with a password shorter than 8 characters.
NEO4J_PASSWORD=replace-me-with-openssl-rand-hex-32
NEO4J_USER=neo4j

# --- image --------------------------------------------------------------------
# Pinned, and multi-arch (linux/amd64 + linux/arm64), so Apple Silicon gets a
# native image with no separate tag. Bumping: check the new tag publishes both
# architectures (`docker manifest inspect`), then update this and the README.
HEADROOM_IMAGE=ghcr.io/headroomlabs-ai/headroom:0.36.5

# --- host ports ---------------------------------------------------------------
# All loopback-bound in docker-compose.yml; these are the host side only.
# 7474/7687/6333 are common defaults — change them here if something else on
# this machine already listens there.
HEADROOM_PORT=8787
# Browser-friendly dashboard: same dashboard as :8787/dashboard, but the
# proxy token is injected server-side by dashboard-gateway, so a plain
# browser tab just works with nothing to paste. :8787 is unaffected — agents
# and clients keep pointing there with the real token, unchanged.
HEADROOM_DASHBOARD_PORT=8788
QDRANT_REST_PORT=6333
QDRANT_GRPC_PORT=6334
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# --- neo4j sizing -------------------------------------------------------------
# Neo4j sizes its heap from host RAM by default, which is wrong inside a shared
# Docker VM: this stack sits alongside agentmemory and kokoro. Raise these if
# the graph gets large and queries slow down.
NEO4J_HEAP=512m
NEO4J_PAGECACHE=256m
