{
  "schemaVersion": 1,
  "headroom": {
    "version": "0.36.5",
    "proxyUrl": "http://127.0.0.1:8787",
    "dashboardUrl": "http://127.0.0.1:8788/dashboard",
    "mcp": {
      "transport": "stdio",
      "container": "ts-headroom-proxy",
      "command": "headroom",
      "args": [
        "mcp",
        "serve",
        "--transport",
        "stdio",
        "--proxy-url",
        "http://127.0.0.1:8787"
      ]
    },
    "healthPaths": [
      "/readyz",
      "/health"
    ],
    "dockerImage": "ghcr.io/headroomlabs-ai/headroom:0.36.5",
    "generatedSecrets": [
      {
        "key": "HEADROOM_PROXY_TOKEN",
        "bytes": 32,
        "encoding": "hex",
        "placeholder": "replace-me-with-openssl-rand-hex-32"
      },
      {
        "key": "NEO4J_PASSWORD",
        "bytes": 32,
        "encoding": "hex",
        "placeholder": "replace-me-with-openssl-rand-hex-32"
      }
    ]
  },
  "caveman": {
    "version": "2.2.0",
    "source": "JuliusBrussee/caveman#v2.2.0",
    "claudeMarketplace": "JuliusBrussee/caveman@v2.2.0",
    "skill": "caveman"
  },
  "agentmemory": {
    "version": "0.9.29",
    "source": "rohitg00/agentmemory",
    "ref": "v0.9.29",
    "restUrl": "http://127.0.0.1:3111",
    "viewerUrl": "http://127.0.0.1:3113"
  }
}
