# ~/.zshrc.local — per-machine overrides, sourced at the end of ~/.zshrc.
# This file is NOT tracked by chezmoi. Copy this example, drop the .example
# suffix, and edit for the current host:
#
#   cp ~/.zshrc.local.example ~/.zshrc.local
#
# Things that belong here: hostname-specific aliases, peer addresses,
# GPU/server-role helpers, credentials paths — anything that shouldn't
# propagate to other machines via the shared repo.

# ── Work workspace override ───────────────────────────────────────────────────
# wsw looks for a *_Work / *-Work sibling of the main workspace. Set this only
# when the work tree lives somewhere unrelated. You do not have to edit this by
# hand: `wsw --set /path/to/work` writes the line below (backing this file up
# first) and applies it to the running shell.
#
# export WORK_WORKSPACE_DIR="$HOME/clients/acme"

# ── Workspace location override ───────────────────────────────────────────────
# ws/wsp/wspu autodetect the workspace from a candidate list (~/Documents/Workspace,
# ~/workspace, ~/Workspace — see _ts_workspace in ~/.zshrc). On WSL the Windows
# workspace under /mnt/c is NOT a candidate: reaching it over drvfs is slow, and a
# WSL install keeps its files on the Linux filesystem. Point WORKSPACE_DIR at it
# here if you want the Windows one anyway.
# Only set this when the autodetect is wrong for this machine. The installer
# writes this line for you when your answer differs from the autodetect.
#
# export WORKSPACE_DIR="$HOME/src"

# ── Local (machine-disk) workspace root ───────────────────────────────────────
# A SECOND root, searched by wsj/wsmb/... after the main one, and reached
# directly with `wsloc`. It defaults to ~/LocalWorkspace when that exists, so
# most machines need no line here at all.
#
# It exists for repos that cannot live on the main root: a workspace on a
# mounted data volume takes every symlink into it down with the mount, and
# `nofail` in fstab makes that silent -- the mountpoint is still there and the
# tree under it is empty. A dotfiles repo stowed into $HOME is the usual case.
# `wso` never scans or migrates this root, deliberately.
#
# export LOCAL_WORKSPACE_DIR="$HOME/LocalWorkspace"

# ── Keychain-style ssh key loading ────────────────────────────────────────────
# The bootstrap STARTS an agent (`common_ssh_agent`) and ~/.zshrc finds its
# socket; neither puts keys in it. On most machines nothing more is needed --
# `AddKeysToAgent yes` in ~/.ssh/config means the first ssh to a host prompts
# once and nothing after it does. Uncomment this to front-load that instead:
# one prompt per key per boot, and `sshkeys` to do it on demand.
#
# The stamp under $XDG_RUNTIME_DIR is what makes declining the prompt survivable
# -- the kernel clears that directory at logout, so it re-asks once per boot and
# not once per pane.
#
# _ts_ssh_identities() {
#   [[ -r "$HOME/.ssh/config" ]] || return 0
#   local f
#   awk 'tolower($1) == "identityfile" { print $2 }' "$HOME/.ssh/config" \
#   | while IFS= read -r f; do
#       # A ~/.ssh/config written on the Windows side is CRLF, and OpenSSH itself
#       # tolerates the trailing \r -- so it is invisible until something like
#       # this reads the file and every path silently stops existing.
#       f="${f%$'\r'}"
#       f="${f/#\~/$HOME}"
#       [[ -f "$f" ]] && print -r -- "$f"
#     done | sort -u
# }
#
# # Add only what is missing. Comparing fingerprints matters: ssh-add on a key
# # the agent already holds prompts for the passphrase again and changes nothing.
# sshkeys() {
#   if [[ ! -S "${SSH_AUTH_SOCK:-}" ]]; then
#     print -u2 "sshkeys: no agent; systemctl --user status ssh-agent.service"
#     return 1
#   fi
#   local loaded f fp
#   local -a missing
#   loaded="$(ssh-add -l 2>/dev/null)"
#   for f in ${(f)"$(_ts_ssh_identities)"}; do
#     fp="$(ssh-keygen -lf "$f.pub" 2>/dev/null | awk '{print $2}')"
#     [[ -n "$fp" && "$loaded" == *"$fp"* ]] && continue
#     missing+=("$f")
#   done
#   (( ${#missing} )) || { print "sshkeys: agent already holds every key"; return 0 }
#   ssh-add "${missing[@]}"
# }
#
# _ts_ssh_autoload() {
#   [[ -o interactive && -t 0 ]] || return 0
#   [[ -S "${SSH_AUTH_SOCK:-}" ]] || return 0
#   # An inbound session's agent is the CLIENT's, forwarded. Loading this host's
#   # keys into it would push them somewhere they were never meant to go.
#   [[ -n "${SSH_CONNECTION:-}" ]] && return 0
#   local stamp="${XDG_RUNTIME_DIR:-/tmp}/terminal-stack/ssh-keys-attempted"
#   [[ -e "$stamp" ]] && return 0
#   mkdir -p "${stamp:h}" 2>/dev/null || return 0
#   : > "$stamp"
#   sshkeys
# }
# _ts_ssh_autoload

# Where `db` / `dbx` jump to. Only needed when Dropbox is somewhere the
# autodetect misses — it already reads Dropbox's own info.json and probes
# ~/Library/CloudStorage/Dropbox and ~/Dropbox.
# export DROPBOX_DIR="$HOME/Dropbox (Work)"

# ── Runtime clone location (rarely needed) ────────────────────────────────────
# tstack update / tstack config / wso / doc find the clone on their own: $TERMINAL_STACK_DIR,
# then chezmoi's sourceDir, then the canonical location and the legacy defaults.
# On POSIX the installer records the clone as chezmoi's sourceDir, so you should
# not normally need this at all — export it only to point at a clone kept
# somewhere unusual, or at a dev checkout (which is otherwise invisible to
# resolution on purpose).
#
# If you see "stale $TERMINAL_STACK_DIR", the line below points at a path with
# no clone. Delete it, or run 'tstack doctor --repair'.
#
# export TERMINAL_STACK_DIR="$HOME/dotfiles/terminal-stack"

# ── Project-specific navigation ───────────────────────────────────────────────
# Shortcuts into specific repos under the workspace. These are per-machine
# because the projects only exist on some hosts. _ts_workspace resolves the
# root, so the same line works wherever the project is checked out.
#
# wscalibra()  { cd "$(_ts_workspace)/md-validator" }
# wsnetsuite() { cd "$(_ts_workspace)/netsuite-customizations" }

# ── Example: dotfiles sync between two specific peers ─────────────────────────
# Used between a pair of machines (hostA <-> hostB). The hostname check makes the same
# file work on either side without edits — peer is always "the other one".
# Note: pull each file with its own rsync — a single rsync with two remote
# sources flattens into the destination dir (.ssh/config would land at ~/config).
#
# _DOTPEER=$( [[ $(hostname -s) == "hostA" ]] && echo "hostB" || echo "hostA" )
# dot-push() { rsync -av ~/.zshrc "<your-user>@${_DOTPEER}:~/" && rsync -av ~/.ssh/config "<your-user>@${_DOTPEER}:~/.ssh/"; }
# dot-pull() { rsync -av "<your-user>@${_DOTPEER}:~/.zshrc" ~/ && rsync -av "<your-user>@${_DOTPEER}:~/.ssh/config" ~/.ssh/; }
