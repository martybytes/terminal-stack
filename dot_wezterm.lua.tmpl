-- ~/.wezterm.lua — macOS counterpart of windows/.wezterm.lua.tmpl.
-- chezmoi applies this only on darwin; native Linux hosts in this stack are
-- headless (ssh/PuTTY) and need no WezTerm GUI config.
-- Structure: theme palettes → base options → QoL (quick select, hyperlinks) →
-- keys/key_tables → plugins (tabline status bar, sessionizer, resurrect; each
-- pcall-guarded with a hand-rolled fallback) → tab titles + Claude cc_state
-- rendering → pane background tint → pane_nav (F1..F6 directional nav-or-split).
-- Keep in sync with windows/.wezterm.lua.tmpl.
--
-- This file is a chezmoi template: leader chord + theme mode are injected from
-- the saved config in chezmoi [data]. Change them with `ts-config`.

local wezterm = require 'wezterm'
local act = wezterm.action
local pane_nav = require 'pane_nav'
local config = wezterm.config_builder()

-- On macOS the default program is the login shell (zsh) — no default_prog needed.

config.ssh_domains = wezterm.default_ssh_domains()
for _, dom in ipairs(config.ssh_domains) do
  dom.assume_shell = 'Posix'
end

-- Optional: host panes in a multiplexer process outside the GUI, so a GUI crash
-- leaves every pane (and everything running in it) alive and relaunching WezTerm
-- reattaches. OFF by default — the mux server loads its OWN copy of this file, so
-- config that affects pane spawning needs a mux restart (which kills every pane)
-- and not just a GUI reload, and pane:inject_output (the Claude pane tint below)
-- is local-pane-only. Toggle with `ts-mux on` / `ts-mux off`; `ts-mux -h` also has
-- status / kill / restart / reset. Keep in sync with windows/.wezterm.lua.tmpl.
local MUX_ENABLED = '{{ if hasKey . "weztermMux" }}{{ .weztermMux }}{{ else }}off{{ end }}' == 'on'
if MUX_ENABLED then
  config.unix_domains = { { name = 'main' } }
  config.default_domain = 'main'
end

-- Optional: reopen the last session at GUI start — the tabs, panes, layout and
-- scrollback you had when you last closed WezTerm. OFF by default: a terminal
-- that silently reopens yesterday's shells is a surprise rather than a feature,
-- and the autosave below keeps Leader+L available whenever you do want it back.
-- Toggle with `ts-config restore on` / `off`.
local RESTORE_ENABLED = '{{ if hasKey . "weztermRestore" }}{{ .weztermRestore }}{{ else }}off{{ end }}' == 'on'

