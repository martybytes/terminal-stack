# OSC 7: host + cwd for WezTerm's pane-aware status (and other OSC-7 terminals).
# Prefer WezTerm's own integration script when installed; otherwise emit OSC 7 here.
# Guarded too: the integration script installs precmd/preexec hooks that emit OSC 133/7/1337,
# which is exactly the noise agent shells must not have in captured stdout.
if [[ -z "${__WEZTERM_SHELL_INTEGRATION_LOADED:-}" ]] && ! _ts_agent_shell; then
  for _wsi in \
    "${WEZTERM_CONFIG_DIR:-}/wezterm-shell-integration.sh" \
    "$HOME/.config/wezterm/wezterm-shell-integration.sh" \
    "/opt/homebrew/share/wezterm/wezterm-shell-integration.sh" \
    "/usr/local/share/wezterm/wezterm-shell-integration.sh" \
    "/usr/share/wezterm/wezterm-shell-integration.sh"; do
    if [[ -r "$_wsi" ]]; then source "$_wsi"; break; fi
  done
  unset _wsi
fi
if [[ -z "${__WEZTERM_SHELL_INTEGRATION_LOADED:-}" ]] && ! _ts_agent_shell; then
