# Git muscle-memory overrides. The OMZ git plugin defines gp='git push' and
# gl='git pull' — on this stack gp means PULL and gl means LOG, everywhere.
# Defined after oh-my-zsh sources so these win. gst/gco/gf/gd/ga/gb keep
# their OMZ meanings.
alias gp='git pull'
alias gl='git log --oneline --graph --decorate -10'

# Claude Code shorthands (PowerShell equivalents live in windows/Documents/PowerShell/Microsoft.PowerShell_profile.ps1).
# Each cc* sets the WezTerm tab title to the bare project leaf while claude runs
# and clears it on exit — no 'cc' prefix: the tab bar's Claude icon and state
# dots already say Claude, and the prefix wasted tab width.
_wez_tab_title() {
  [[ -n "$WEZTERM_PANE" ]] || return
  wezterm cli set-tab-title "$1" >/dev/null 2>&1
  # Empty title marks CC exit in this pane -> clear cc_state; WezTerm Lua restores bg.
  if [[ -z "$1" ]]; then
    local uv=$'\033]1337;SetUserVar=cc_state=\007'
    if [[ -n "$TMUX" ]]; then
      uv=$'\033Ptmux;\033'"${uv}"$'\033\\'
    fi
    printf '%s' "$uv" > /dev/tty 2>/dev/null
  fi
}

# Per-machine agent settings are read at launch. WSL uses the Windows mirror
# because the actual GUI agents live there; native Unix reads chezmoi [data].
_ts_agent_setting() {
  local key="$1" def="${2:-off}" env_name="" value="" cfg=""
  case "$key" in
    headroomEnabled) env_name=TS_HEADROOM ;;
    headroomCursorMode) env_name=TS_HEADROOM_CURSOR ;;
    cavemanEnabled) env_name=TS_CAVEMAN ;;
    agentmemoryEnabled) env_name=TS_AGENTMEMORY ;;
  esac
  [[ -n "$env_name" ]] && value="${(P)env_name:-}"
  if [[ -z "$value" && -n "${WSL_DISTRO_NAME:-}" ]] && command -v cmd.exe >/dev/null 2>&1; then
    local winuser="$(cmd.exe /c 'echo %USERNAME%' 2>/dev/null | tr -d '\r\n')"
    cfg="/mnt/c/Users/$winuser/AppData/Local/terminal-stack/config.json"
    if [[ -f "$cfg" ]] && command -v python3 >/dev/null 2>&1; then
      value="$(python3 - "$cfg" "$key" <<'PY' 2>/dev/null
import json, sys
try: print(json.load(open(sys.argv[1], encoding='utf-8')).get(sys.argv[2], ''), end='')
except Exception: pass
PY
)"
    fi
  fi
  if [[ -z "$value" ]]; then
    cfg="$HOME/.config/chezmoi/chezmoi.toml"
    [[ -f "$cfg" ]] && value="$(sed -nE "s/^${key}[[:space:]]*=[[:space:]]*\"([^\"]*)\".*/\\1/p" "$cfg" | head -1)"
  fi
  print -r -- "${value:-$def}" | tr 'A-Z' 'a-z'
}

typeset -gi _TS_HEADROOM_PROBE_AT=0
typeset -gi _TS_HEADROOM_PROBE_OK=0
typeset -gi _TS_HEADROOM_WARNED=0
_ts_headroom_healthy() {
  [[ "$(_ts_agent_setting headroomEnabled)" == on ]] || return 1
  local now="$(date +%s)"
  if (( now - _TS_HEADROOM_PROBE_AT < 5 )); then (( _TS_HEADROOM_PROBE_OK )); return; fi
  _TS_HEADROOM_PROBE_AT=$now; _TS_HEADROOM_PROBE_OK=0
  curl -fsS --max-time 1 http://127.0.0.1:8787/readyz >/dev/null 2>&1 \
    || curl -fsS --max-time 1 http://127.0.0.1:8787/health >/dev/null 2>&1 \
    || return 1
  _TS_HEADROOM_PROBE_OK=1
}

# Resolve an agent CLI at CALL time and cache the hit, rather than snapshotting
# it at shell load. These CLIs are routinely installed *into an already-open
# shell* (`curl … | bash` into ~/.local/bin), and a load-time snapshot left every
# wrapper in that shell dead until the user opened a new tab. `rehash` first:
# zsh caches the PATH directory listing, so a binary added since startup is
# invisible to $commands until the hash table is rebuilt. Same shape as
# _ts_chezmoi below, including the literal ~/.local/bin fallback.
#   $1 = command name, $2 = name of the variable to cache the path in
# Sets $2 in the CALLER's shell rather than echoing the path: callers must not
# wrap this in $( ), because the subshell would throw the cache away and every
# launch would re-scan PATH.
_ts_agent_bin() {
  local name="$1" var="$2" cached="${(P)var}"
  # Re-check -x: it also self-heals a cached path that vanished, e.g. Claude Code
  # garbage-collecting an old ~/.local/share/claude/versions/* directory.
  [[ -n "$cached" && -x "$cached" ]] && return 0
  rehash
  local found="${commands[$name]:-$(whence -p "$name" 2>/dev/null)}"
  [[ -z "$found" && -x "$HOME/.local/bin/$name" ]] && found="$HOME/.local/bin/$name"
  [[ -n "$found" ]] || return 1
  typeset -g "$var=$found"
}
typeset -g _TS_CLAUDE_BIN=""
_ts_claude_bin() {
  _ts_agent_bin claude _TS_CLAUDE_BIN && return 0
  print -u2 'claude: not found. Install it with: curl -fsSL https://claude.ai/install.sh | bash'
  return 127
}
claude-stock() {
  _ts_claude_bin || return 127
  "$_TS_CLAUDE_BIN" "$@"
}
claude() {
  _ts_claude_bin || return 127
  if [[ "$(_ts_agent_setting headroomEnabled)" != on ]]; then "$_TS_CLAUDE_BIN" "$@"; return; fi
  if ! _ts_headroom_healthy; then
    if (( ! _TS_HEADROOM_WARNED )); then
      print -u2 'warning: Headroom is enabled but unavailable on 127.0.0.1:8787; this Claude launch is going direct.'
      _TS_HEADROOM_WARNED=1
    fi
    "$_TS_CLAUDE_BIN" "$@"; return
  fi
  ANTHROPIC_BASE_URL=http://127.0.0.1:8787 \
    ENABLE_TOOL_SEARCH="${ENABLE_TOOL_SEARCH:-true}" HEADROOM_PROJECT="${PWD:t}" \
    "$_TS_CLAUDE_BIN" "$@"
}
# { } always { }: the title clears even when Ctrl+C aborts the function body
# (matches the pwsh wrappers' try/finally); exit status of the body is preserved.
cc()    { _wez_tab_title "${PWD:t}"; { claude "$@" }                                           always { _wez_tab_title "" } }
ccc()   { _wez_tab_title "${PWD:t}"; { claude --continue "$@" }                                always { _wez_tab_title "" } }
ccd()   { _wez_tab_title "${PWD:t}"; { claude --dangerously-skip-permissions "$@" }            always { _wez_tab_title "" } }
ccdc()  { _wez_tab_title "${PWD:t}"; { claude --dangerously-skip-permissions --continue "$@" } always { _wez_tab_title "" } }
ccr()   { _wez_tab_title "${PWD:t}"; { claude --resume "$@" }                                  always { _wez_tab_title "" } }
ccdr()  { _wez_tab_title "${PWD:t}"; { claude --dangerously-skip-permissions --resume "$@" }   always { _wez_tab_title "" } }
cca()   { _wez_tab_title "agents";   { claude agents }                                         always { _wez_tab_title "" } }

# Interactive Codex sessions get a three-row WezTerm dashboard. Utility commands
# remain stock, and codex-stock is an explicit no-enhancements escape hatch.
typeset -g _TS_CODEX_BIN=""
_ts_codex_bin() {
  _ts_agent_bin codex _TS_CODEX_BIN && return 0
  print -u2 'codex: not found. Install it with: npm install -g @openai/codex  (or see github.com/openai/codex/releases)'
  return 127
}

_ts_codex_is_interactive() {
  local arg skip_value=0
  local -a value_options utility_commands
  value_options=(-c --config --enable --disable -i --image -m --model --local-provider -p --profile
    -s --sandbox -C --cd --add-dir -a --ask-for-approval --remote --remote-auth-token-env)
  utility_commands=(exec e review login logout mcp plugin mcp-server app-server
    remote-control app completion update doctor sandbox debug apply a archive delete
    migrate-rollouts unarchive cloud exec-server features help)

  for arg in "$@"; do
    [[ "$arg" == (-h|--help|-V|--version) ]] && return 1
  done
  for arg in "$@"; do
    if (( skip_value )); then skip_value=0; continue; fi
    [[ "$arg" == -- ]] && return 0
    [[ "$arg" == --*=* ]] && continue
    if (( ${value_options[(Ie)$arg]} )); then skip_value=1; continue; fi
    [[ "$arg" == -* ]] && continue
    [[ "$arg" == (resume|fork) ]] && return 0
    (( ${utility_commands[(Ie)$arg]} )) && return 1
    return 0
  done
  return 0
}

codex-stock() {
  _ts_codex_bin || return 127
  "$_TS_CODEX_BIN" "$@"
}

_ts_codex() {
  local launch_mode="$1"
  shift
  local helper="$HOME/.codex/hooks/terminal_stack.py"
  local profile="$HOME/.codex/terminal-stack.config.toml"
  local parent="${WEZTERM_PANE:-}" sidecar="" launched
  local -a command status_command
  local OPENAI_BASE_URL="${OPENAI_BASE_URL:-}" HEADROOM_PROJECT="${HEADROOM_PROJECT:-}"
  # Resolve before building the command line — the old order populated
  # command=() from the cached variable and only checked it was set afterwards.
  _ts_codex_bin || return 127
  command=("$_TS_CODEX_BIN")
  [[ "$launch_mode" == yolo ]] && command+=(--yolo)
  launched="$(date +%s)"

  if command -v python3 >/dev/null 2>&1 && [[ -f "$helper" && -f "$profile" ]]; then
    command+=(-p terminal-stack)
  else
    print -u2 'terminal-stack: Codex dashboard/profile unavailable; running without enhancements.'
  fi

  if [[ "$(_ts_agent_setting headroomEnabled)" == on ]]; then
    if _ts_headroom_healthy; then
      OPENAI_BASE_URL=http://127.0.0.1:8787/v1
      HEADROOM_PROJECT="${PWD:t}"
      export OPENAI_BASE_URL HEADROOM_PROJECT
      command+=(--config 'openai_base_url="http://127.0.0.1:8787/v1"')
    elif (( ! _TS_HEADROOM_WARNED )); then
      print -u2 'warning: Headroom is enabled but unavailable on 127.0.0.1:8787; this Codex launch is going direct.'
      _TS_HEADROOM_WARNED=1
    fi
  fi

  if [[ -n "$parent" ]] && command -v wezterm >/dev/null 2>&1 \
      && command -v python3 >/dev/null 2>&1 && [[ -f "$helper" ]]; then
    if [[ -n "${WSL_DISTRO_NAME:-}" ]] && command -v wsl.exe >/dev/null 2>&1; then
      status_command=(wsl.exe --distribution "$WSL_DISTRO_NAME" --cd "$PWD" --exec
        python3 "$helper" dashboard --pane "$parent" --cwd "$PWD" --launched-at "$launched")
    else
      status_command=(python3 "$helper" dashboard --pane "$parent" --cwd "$PWD" --launched-at "$launched")
    fi
    sidecar="$(wezterm cli split-pane --pane-id "$parent" --bottom --cells 3 -- "${status_command[@]}" 2>/dev/null || true)"
    [[ "$sidecar" == <-> ]] || sidecar=""
    wezterm cli activate-pane --pane-id "$parent" >/dev/null 2>&1 || true
  fi

  local TS_CODEX_PARENT_PANE="$parent"
  export TS_CODEX_PARENT_PANE
  local rc=0
  { "${command[@]}" "$@"; rc=$? } always {
    if [[ -n "$sidecar" ]]; then
      wezterm cli kill-pane --pane-id "$sidecar" >/dev/null 2>&1 || true
    fi
    if command -v python3 >/dev/null 2>&1 && [[ -f "$helper" && -n "$parent" ]]; then
      python3 "$helper" cleanup --pane "$parent" >/dev/null 2>&1 || true
    fi
  }
  return "$rc"
}
codex() { if _ts_codex_is_interactive "$@"; then _ts_codex safe "$@"; else codex-stock "$@"; fi }
cy()    { _ts_codex yolo "$@" }
cyr()   { _ts_codex yolo resume "$@" }

# Escape hatch: vanilla zsh, no rc files (no oh-my-zsh/starship/aliases).
