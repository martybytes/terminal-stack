    local h="${${$(hostname -s 2>/dev/null):-${HOST:-$(hostname)}}// /}"
    printf '\033]7;file://%s%s\033\\' "${h:l}" "$PWD"
  }
  add-zsh-hook precmd _wezterm_osc7
fi

# Start/attach a Claude Code tmux session for the current repo or named task.
ccs() {
  local name="${1:-$(basename "$PWD")}"
  name="${name//[^A-Za-z0-9_.-]/_}"
  [[ -n "$WEZTERM_PANE" ]] && wezterm cli set-tab-title "$name" >/dev/null 2>&1
  tmux new-session -A -s "cc-$name" -n claude "claude --name \"$name\""
}

# SSH + remote tmux attach/create in one shot.
ssht() {
  local host="$1" sess="${2:-main}"
  if [[ -z "$host" ]]; then echo "usage: ssht host [session]"; return 2; fi
  [[ -n "$WEZTERM_PANE" ]] && wezterm cli set-tab-title "ssh-$host:$sess" >/dev/null 2>&1
  ssh -t -- "$host" "tmux new-session -A -s $(printf '%q' "$sess")"
}

# Shared resolvers for ts-update / ts-rollback.
# TERMINAL_STACK_CHEZMOI overrides the chezmoi binary (testing / odd installs).
_ts_chezmoi() {
  if [[ -n "${TERMINAL_STACK_CHEZMOI:-}" ]]; then echo "$TERMINAL_STACK_CHEZMOI"
  elif [[ -x "$HOME/.local/bin/chezmoi" ]]; then echo "$HOME/.local/bin/chezmoi"
  elif command -v chezmoi >/dev/null 2>&1; then command -v chezmoi
  else return 1
  fi
}
# The canonical runtime clone location. WSL shares one clone with Windows in
# %LOCALAPPDATA%\terminal-stack\stack; native Linux/macOS use the XDG data home.
# Pins (TERMINAL_STACK_DIR) are only for NON-canonical locations. Twin of
# bootstrap/_config.sh ts_canonical_clone_dir (see docs/decisions.md).
_ts_canonical_clone() {
  if [[ -r /proc/version ]] && grep -qi microsoft /proc/version 2>/dev/null; then
    local m
    for m in /mnt/c/Users/*/AppData/Local/terminal-stack/stack(N); do
      echo "$m"; return 0
    done
    # No clone there yet: derive the path from the interop username.
    local wu
    wu="$(/mnt/c/Windows/System32/cmd.exe /c 'echo %USERNAME%' 2>/dev/null | tr -d '\r\n')"
    [[ -n "$wu" ]] && { echo "/mnt/c/Users/$wu/AppData/Local/terminal-stack/stack"; return 0; }
    return 1
  fi
  echo "${XDG_DATA_HOME:-$HOME/.local/share}/terminal-stack"
}

# True when a path is a DEV clone at a wso workspace tier path
# (<tier>/<host-with-dot>/<owner>/<repo>). Dev clones are invisible to
# auto-resolution unless pinned. Twin of bootstrap/_cleanup.sh ts_is_dev_clone.
_ts_is_dev_clone() {
  [[ "$1" =~ /(src|public|archive|local|scratch)/[^/]+\.[^/]+/[^/]+/[^/]+/?$ ]]
}

# CANONICAL CLONE CANDIDATE LIST (zsh replica) — canonical location first, then
# legacy defaults. Keep in sync with docs/decisions.md § "Runtime clone location"
# and the siblings: bootstrap/_cleanup.sh ts_clone_candidates (master), profile
# Get-TsCloneCandidates, bootstrap/_cleanup.ps1 Get-TsCleanupCloneCandidates.
_ts_clone_candidates() {
  echo "$(_ts_canonical_clone 2>/dev/null)"
  printf '%s\n' \
    "$HOME/code/terminal-stack" "$HOME/terminal-stack" \
    "$HOME/Workspace/terminal-stack" "$HOME/workspace/terminal-stack" \
    "$HOME/Documents/Workspace/terminal-stack" "$HOME/.local/share/chezmoi"
  local d
  for d in /mnt/c/Users/*/terminal-stack(N) /mnt/c/DATA/Workspace/terminal-stack(N); do
    echo "$d"
  done
}

# Clone resolution: $TERMINAL_STACK_DIR → `chezmoi source-path`. $2 is the
# caller name for error prefixes. Each failure mode gets its own message —
# a chezmoi error (e.g. state lock held by another running instance) is not
# a missing clone, so chezmoi's stderr passes through unredirected.
# Every terminal-stack clone on this machine, one path per line. A directory
# counts only when it is a git repo whose origin names the project — the name
# test alone is not enough to *choose* one (a stale install from an old account
# still matches), which is why callers report rather than silently switch.
# Dev clones (workspace tier paths) are skipped — only an explicit pin sees them.
_ts_clones() {
  local d u seen=""
  { echo "${TERMINAL_STACK_DIR:-}"; _ts_clone_candidates; } | while IFS= read -r d; do
    [[ -n "$d" && -d "$d/.git" ]] || continue
    if _ts_is_dev_clone "$d" && [[ "$d" != "${TERMINAL_STACK_DIR:-}" ]]; then continue; fi
    case " $seen " in *" $d "*) continue ;; esac
    u="$(git -C "$d" config --get remote.origin.url 2>/dev/null)"
    [[ "${u:l}" == *terminal-stack* ]] || continue   # :l — match case-insensitively like the pwsh side
    seen="$seen $d"
    echo "$d"
  done
}

# A dangling $TERMINAL_STACK_DIR degrades rather than dead-ending: the pin is
# inherited by every shell, so a stale one would otherwise brick ts-update / wso
# / doc with no way out. Fall back to chezmoi's sourceDir, then the candidate
# list. Twin of the profile's Resolve-TsSourceDir.
_ts_src() {
  local cz="$1" name="${2:-ts}" src="${TERMINAL_STACK_DIR:-}" stale=""
  if [[ -n "$src" && ! -d "$src/.git" ]]; then
    echo "$name: stale \$TERMINAL_STACK_DIR — no clone at '$src'; searching the usual locations." >&2
    echo "$name: clear it with 'ts-doctor --repair', or unset it in ~/.zshrc.local." >&2
    stale=1
    src=""
  fi
  if [[ -z "$src" ]]; then
    src="$("$cz" source-path)" || {
      echo "$name: 'chezmoi source-path' failed (error above) — can't locate the clone." >&2
      return 1
    }
  fi
  if [[ ! -d "$src/.git" ]]; then
    src="$(TERMINAL_STACK_DIR= _ts_clones | head -n1)"
  fi
  if [[ ! -d "$src/.git" ]]; then
    echo "$name: no terminal-stack clone found. Re-run the install one-liner." >&2
    return 1
  fi
  [[ -n "$stale" ]] && echo "$name: using $src" >&2
  echo "$src"
}
_TS_STATE="${XDG_STATE_HOME:-$HOME/.local/state}/terminal-stack"

# Pull the latest terminal-stack from GitHub and re-apply via chezmoi.
# Shows incoming commits and records the pre-update SHA so ts-rollback can undo.
# Same name as the PowerShell alias for cross-shell muscle memory.
ts-update() {
  local cz src
  cz="$(_ts_chezmoi)" || { echo "ts-update: chezmoi not found on PATH." >&2; return 1 }
  src="$(_ts_src "$cz" ts-update)" || return 1
  # Preflight: a sourceDir pointing at a non-terminal-stack clone means a stale
  # install. Nudge toward ts-doctor rather than pulling the wrong repo.
  git -C "$src" config --get remote.origin.url 2>/dev/null | grep -qi terminal-stack \
    || echo "ts-update: note — '$src' doesn't look like a terminal-stack clone. Run 'ts-doctor' to check." >&2
  echo "==> clone: $src"
  # Location notice only — moving is ts-doctor's job, never a side effect of updating.
  local _canon; _canon="$(_ts_canonical_clone 2>/dev/null)"
  if [[ -n "$_canon" && "$src" != "$_canon" ]] && ! _ts_is_dev_clone "$src"; then
    echo "ts-update: note — clone is at a legacy location; run 'ts-doctor --repair' to move it to $_canon." >&2
  fi
  # A leftover second clone is not just untidy: whichever one ts-update picks is
  # the one that re-deploys your config, so an unnoticed old clone silently
  # reinstates an old profile. Report the others rather than choosing quietly;
  # `ts-doctor --repair` repoints chezmoi's sourceDir for good.
  local other others=""
  for other in $(_ts_clones); do
    [[ "$other" == "$src" ]] && continue
    others="$others $other"
  done
  if [[ -n "$others" ]]; then
    echo "ts-update: note — other terminal-stack clones on this machine:" >&2
    for other in ${=others}; do
      echo "    $other  ($(git -C "$other" log -1 --format='%h %s' 2>/dev/null | cut -c1-50))" >&2
    done
    echo "    Only '$src' is being updated. Run 'ts-doctor --repair' if that's the wrong one." >&2
  fi
  git -C "$src" fetch --quiet || return $?
  local incoming
  incoming="$(git -C "$src" log --oneline 'HEAD..@{u}' 2>/dev/null)"
  if [[ -n "$incoming" ]]; then
    echo "==> incoming changes:"
    print -r -- "$incoming" | sed 's/^/  /'
    # Record the rollback point only when something is actually incoming —
    # a no-op re-run must not clobber the last real rollback point.
    mkdir -p "$_TS_STATE"
    git -C "$src" rev-parse HEAD > "$_TS_STATE/rollback-sha"
    echo "==> recorded rollback point: $(git -C "$src" rev-parse --short HEAD) (ts-rollback to undo)"
    git -C "$src" pull --ff-only || return $?
  else
    echo "==> already up to date"
  fi
  # Re-bake the resolved (light/dark) palette from the live OS theme so a
  # `follow`-mode user who toggled the OS appearance gets the new Starship/tmux
  # palette on this update. No-op for fixed dark/light. Runs in bash because the
  # helpers are bash; failure is non-fatal.
  TERMINAL_STACK_DIR="$src" TERMINAL_STACK_CHEZMOI="$cz" \
    bash -c 'source "$1/bootstrap/_config.sh" && ts_refresh_resolved_theme' _ "$src" >/dev/null 2>&1 || true
  # `apply` without -v: -v prints the full content of every run_after_*
  # script (incl. our 114-line sync hook) as a git-style diff on every run,
  # which looks like a pager opening on long-output. Use `chezmoi diff` if
  # you want to preview.
  "$cz" apply
  # Config files are only half an update: a release that adds a CLI tool is
  # inert until the tool exists. Offer the gap rather than installing behind
  # your back, and stay silent when there is nothing to do.
  local pending
  pending="$(TERMINAL_STACK_CHEZMOI="$cz" bash -c \
    'source "$1/bootstrap/_config.sh" >/dev/null 2>&1 && ts_apps_pending' _ "$src" 2>/dev/null)"
  if [[ -n "$pending" ]]; then
    echo "==> ${#${(z)pending}} app(s) from the catalog are not installed:"
    local a
    for a in ${=pending}; do
      printf '    %-10s %s\n' "$a" "$(bash -c 'source "$1/bootstrap/_config.sh" >/dev/null 2>&1 && ts_app_desc "$2"' _ "$src" "$a" 2>/dev/null)"
    done
    if [[ -t 0 ]]; then
      local ans
      read -r "ans?Install them now? [y/N]: "
      case "$ans" in
        y|Y|yes|YES)
          TERMINAL_STACK_DIR="$src" TERMINAL_STACK_CHEZMOI="$cz" \
            bash "$src/bootstrap/ts-config.sh" apps "$pending" ;;
        *) echo "    Skipped. Run 'ts-config apps' when you want them." ;;
      esac
    else
      echo "    Install them with: ts-config apps"
    fi
  fi
  # The tts daemon keeps running its pre-pull code. Like the mux server it is
  # never auto-restarted (it may be mid-announcement or holding a duck) —
  # nudge instead, same philosophy as ts-mux restart.
  local _tts_note
  _tts_note="$(bash -c 'source "$1/bootstrap/_config.sh" >/dev/null 2>&1 \
    && [ "$(ts_cc_tts_get ccTtsDaemon)" = on ] && ts_cc_tts_daemon_status' _ "$src" 2>/dev/null \
    | grep 'older build' || true)"
  if [[ -n "$_tts_note" ]]; then
    echo "ts-update: note — the tts daemon is running the previous build; 'ts-config tts daemon restart' when convenient." >&2
  fi
}

# Undo the last ts-update: reset the clone to the recorded pre-update SHA and
# re-apply. Manual fallback (state file missing): README § Updating & rollback.
ts-rollback() {
  local cz src
  cz="$(_ts_chezmoi)" || { echo "ts-rollback: chezmoi not found on PATH." >&2; return 1 }
  src="$(_ts_src "$cz" ts-rollback)" || return 1
  local sha_file="$_TS_STATE/rollback-sha"
  if [[ ! -f "$sha_file" ]]; then
    echo "ts-rollback: no recorded rollback point ($sha_file)." >&2
    echo "  Manual procedure: git -C $src reset --hard <sha> && chezmoi apply" >&2
    return 1
  fi
  local sha; sha="$(<"$sha_file")"
  if ! git -C "$src" rev-parse --verify --quiet "$sha^{commit}" >/dev/null; then
    echo "ts-rollback: recorded SHA $sha not found in $src." >&2; return 1
  fi
  # The clone may double as a dev checkout — never reset --hard over real work.
  if [[ -n "$(git -C "$src" status --porcelain)" ]]; then
    echo "ts-rollback: $src has uncommitted changes; refusing to reset --hard. Commit or stash first." >&2
    return 1
  fi
  echo "==> resetting $src to $sha (recorded before last ts-update)"
  git -C "$src" reset --hard "$sha" || return $?
  "$cz" apply
  echo "==> done. run ts-update to return to latest."
}

# Configure the stack: leader key, theme (dark/light/follow), tmux prefix, apps,
# and the WezTerm mux / startup-restore toggles.
# Bare `ts-config` opens an interactive menu; `ts-config theme follow` etc. set one
# value. Thin wrapper over the shared bootstrap/ts-config.sh in the clone, which
# persists to chezmoi [data] and re-applies. In a combined WSL+Windows setup, run
# this from WSL — it also mirrors the choice to the Windows side.
ts-config() {
  local cz src
  cz="$(_ts_chezmoi)" || { echo "ts-config: chezmoi not found on PATH." >&2; return 1 }
  src="$(_ts_src "$cz" ts-config)" || return 1
  git -C "$src" config --get remote.origin.url 2>/dev/null | grep -qi terminal-stack \
    || echo "ts-config: note — '$src' doesn't look like a terminal-stack clone. Run 'ts-doctor' to check." >&2
  TERMINAL_STACK_DIR="$src" TERMINAL_STACK_CHEZMOI="$cz" bash "$src/bootstrap/ts-config.sh" "$@"
}

# WezTerm multiplexer domain: `ts-mux` (status), `ts-mux on|off` (config + apply),
# `ts-mux kill|restart|reset` (the live wezterm-mux-server). Thin wrapper over the
# shared bootstrap/ts-mux.sh in the clone. On WSL the mux server is a WINDOWS
# process — the script reaches it over interop, so this works from either side.
ts-mux() {
  local cz src
  cz="$(_ts_chezmoi)" || { echo "ts-mux: chezmoi not found on PATH." >&2; return 1 }
  src="$(_ts_src "$cz" ts-mux)" || return 1
  if [[ ! -f "$src/bootstrap/ts-mux.sh" ]]; then
    echo "ts-mux: $src/bootstrap/ts-mux.sh not found. Run 'ts-update'." >&2; return 1
  fi
  TERMINAL_STACK_DIR="$src" TERMINAL_STACK_CHEZMOI="$cz" bash "$src/bootstrap/ts-mux.sh" "$@"
}

# Diagnose / repair the install: stale chezmoi sourceDir, missing `doc`, leftover
# old clones, tools off PATH. Read-only by default; `ts-doctor --repair` fixes
# (repoints sourceDir + re-applies + offers cleanup, confirming each step).
# Resilient to a broken sourceDir — probes known clone paths so the doctor still
# runs when `chezmoi source-path` is the very thing that's wrong.
ts-doctor() {
  local cz src c
  cz="$(_ts_chezmoi)" || { echo "ts-doctor: chezmoi not found on PATH." >&2; return 1 }
  src="${TERMINAL_STACK_DIR:-$("$cz" source-path 2>/dev/null)}"
  if [[ ! -f "$src/bootstrap/ts-doctor.sh" ]]; then
    # Probe the shared candidate list (canonical first, dev clones excluded) so
    # the doctor still runs when `chezmoi source-path` is the very thing broken.
    while IFS= read -r c; do
      [[ -n "$c" && -f "$c/bootstrap/ts-doctor.sh" ]] || continue
      _ts_is_dev_clone "$c" && continue
      src="$c"; break
    done < <(_ts_clone_candidates)
  fi
  if [[ ! -f "$src/bootstrap/ts-doctor.sh" ]]; then
    echo "ts-doctor: can't locate a terminal-stack clone. Re-run the install one-liner." >&2
    return 1
  fi
  TERMINAL_STACK_DIR="$src" TERMINAL_STACK_CHEZMOI="$cz" bash "$src/bootstrap/ts-doctor.sh" "$@"
}

# Workspace navigation (mirrors the ws* PowerShell functions).
# $WORKSPACE_DIR (set in ~/.zshrc.local) wins; otherwise the first existing
# autodetect candidate. Resolved at CALL time, not shell startup, because
# ~/.zshrc.local is sourced after this block.
_ts_workspace() {
  [[ -n "${WORKSPACE_DIR:-}" ]] && { echo "$WORKSPACE_DIR"; return 0 }
  local d
  for d in /mnt/c/DATA/Workspace "$HOME/Documents/Workspace" \
           "$HOME/workspace" "$HOME/Workspace"; do
    [[ -d "$d" ]] && { echo "$d"; return 0 }
  done
  return 1
}
# Sibling resolver: handles both Workspace_Personal (Windows/WSL) and
# Workspace-Personal (macOS) naming.
_ts_workspace_sibling() {
  local suffix="$1" root d
  root="$(_ts_workspace)" || return 1
  for d in "${root}_${suffix}" "${root}-${suffix}"; do
    [[ -d "$d" ]] && { echo "$d"; return 0 }
  done
  return 1
}
ws()   { cd "$(_ts_workspace)" 2>/dev/null || echo "ws: no workspace found — export WORKSPACE_DIR in ~/.zshrc.local" >&2 }
wsp()  { cd "$(_ts_workspace_sibling Personal)" 2>/dev/null || echo "wsp: no *_Personal sibling of $(_ts_workspace 2>/dev/null)" >&2 }
# wspu prefers the organised public/ tier and falls back to the old *_Public
# sibling root, so it keeps working before, during and after `wso migrate`.
wspu() {
  local root pub
  root="$(_ts_workspace)" || { echo "wspu: no workspace found" >&2; return 1 }
  pub="$root/public/github.com"
  [[ -d "$pub" ]] || pub="$root/public"
  [[ -d "$pub" ]] || pub="$(_ts_workspace_sibling Public)" || {
    echo "wspu: no public/ tier and no *_Public sibling of $root" >&2; return 1 }
  cd "$pub"
}

# Work workspace. $WORK_WORKSPACE_DIR (set in ~/.zshrc.local) wins; otherwise the
# *_Work / *-Work sibling of the main workspace — same naming rule as wsp/wspu.
# `wsw --set` writes that override for you, so a machine whose work tree lives
# somewhere unrelated to the main workspace needs no hand-editing.
_ts_workspace_work() {
  [[ -n "${WORK_WORKSPACE_DIR:-}" ]] && { echo "$WORK_WORKSPACE_DIR"; return 0 }
  _ts_workspace_sibling Work
}
_ts_workspace_work_set() {
  local dir="${1:-$PWD}" rc="$HOME/.zshrc.local" stamp bak n tmp
  dir="${dir:A}"
  [[ -d "$dir" ]] || { echo "wsw: not a directory: $dir" >&2; return 1 }
  if [[ -f "$rc" ]]; then
    stamp="$(date +%Y%m%d)"; bak="$rc.bak.$stamp"; n=1
    while [[ -e "$bak" ]]; do bak="$rc.bak.$stamp.$n"; n=$((n + 1)); done
    cp "$rc" "$bak" || return 1
    echo "wsw: backup $bak"
    tmp="$rc.wsw.$$"
    grep -v '^[[:space:]]*export[[:space:]][[:space:]]*WORK_WORKSPACE_DIR=' "$rc" > "$tmp" || true
    printf 'export WORK_WORKSPACE_DIR=%q
' "$dir" >> "$tmp"
    mv "$tmp" "$rc" || return 1
    echo "wsw: updated $rc"
  else
    printf '# Per-machine zsh overrides — not tracked by chezmoi.
' > "$rc"
    printf 'export WORK_WORKSPACE_DIR=%q
' "$dir" >> "$rc"
    echo "wsw: created $rc"
  fi
  export WORK_WORKSPACE_DIR="$dir"
  echo "wsw: WORK_WORKSPACE_DIR=$dir"
}
wsw() {
  case "${1:-}" in
    --set|-s) shift; _ts_workspace_work_set "$@"; return $? ;;
    --show)   _ts_workspace_work || { echo "wsw: no work workspace configured" >&2; return 1 }; return 0 ;;
    -h|--help)
      print -r -- 'wsw              cd to the work workspace'
      print -r -- 'wsw --set [dir]  define it in ~/.zshrc.local (default: current dir)'
      print -r -- 'wsw --show       print the resolved path'
      return 0 ;;
  esac
  local d
  if ! d="$(_ts_workspace_work)"; then
    echo "wsw: no work workspace found — looked for \$WORK_WORKSPACE_DIR and *_Work/*-Work siblings of $(_ts_workspace 2>/dev/null)" >&2
    echo "wsw: run 'wsw --set [dir]' to define one in ~/.zshrc.local" >&2
    return 1
  fi
  cd "$d"
}
# Project-specific shortcuts (wscalibra, wsnetsuite, …) belong in
# ~/.zshrc.local — see dot_zshrc.local.example.

# Dropbox navigation (mirrors the db PowerShell function). $DROPBOX_DIR (set in
# ~/.zshrc.local) wins; otherwise Dropbox's own info.json, then the per-platform
# candidates. Resolved at CALL time for the same reason as _ts_workspace, and a
# shell function rather than a script because a child cannot cd its parent.
_ts_dropbox() {
  [[ -n "${DROPBOX_DIR:-}" ]] && { echo "$DROPBOX_DIR"; return 0 }
  local d info
  # info.json is authoritative: it is the only thing that gets a relocated
  # folder, a Business account, or two linked accounts right.
  if command -v python3 >/dev/null 2>&1; then
    for info in "$HOME/.dropbox/info.json" "$HOME/.config/dropbox/info.json"; do
      [[ -r "$info" ]] || continue
      d="$(python3 -c 'import json,sys
try: c = json.load(open(sys.argv[1], encoding="utf-8"))
except Exception: raise SystemExit(0)
for k in ("personal", "business"):
    p = (c.get(k) or {}).get("path")
    if p: print(p); break' "$info" 2>/dev/null)"
      [[ -n "$d" && -d "$d" ]] && { echo "$d"; return 0 }
    done
  fi
  # macOS moved Dropbox under CloudStorage in Ventura; ~/Dropbox persists on
  # Linux and older macOS.
  for d in "$HOME/Library/CloudStorage/Dropbox" "$HOME/Dropbox" \
           "$HOME/Dropbox (Personal)" "$HOME/Dropbox (Business)"; do
    [[ -d "$d" ]] && { echo "$d"; return 0 }
  done
  # Under WSL the real store is the Windows one; reuse the same interop username
  # lookup the sync hook uses.
  if [[ -n "${WSL_DISTRO_NAME:-}" ]] && command -v cmd.exe >/dev/null 2>&1; then
    local wu; wu="$(cmd.exe /c 'echo %USERNAME%' 2>/dev/null | tr -d '\r\n')"
    if [[ -n "$wu" ]]; then
      for d in "/mnt/c/Users/$wu/Dropbox" "/mnt/c/Users/$wu/Dropbox (Personal)" \
               "/mnt/c/Users/$wu/Dropbox (Business)"; do
        [[ -d "$d" ]] && { echo "$d"; return 0 }
      done
    fi
  fi
  return 1
}
db() {
  local d
  d="$(_ts_dropbox)" || {
    echo "db: no Dropbox found — export DROPBOX_DIR in ~/.zshrc.local" >&2
    return 1
  }
  cd "$d"
}
dbx() { db "$@" }

# --- organised tree: per-owner jumps -----------------------------------------
# Repos live at <workspace>/<tier>/<host>/<owner>/<repo>; see `doc workspace-org`.
# These stay shell functions rather than moving into `wso` because a child
# process cannot change the parent shell's directory.
_ts_ws_org_cd() {
  local owner="$1" name="$2" root d
  root="$(_ts_workspace)" || { echo "$name: no workspace found" >&2; return 1 }
  for d in "$root/src/github.com/$owner" "$root/archive/github.com/$owner"; do
    [[ -d "$d" ]] && { cd "$d"; return 0 }
  done
  echo "$name: $root/src/github.com/$owner does not exist yet — run 'wso plan'" >&2
  return 1
}
ws37()  { _ts_ws_org_cd 37metrics        ws37 }
ws42()  { _ts_ws_org_cd dimension42ai    ws42 }
wsmb()  { _ts_ws_org_cd martybytes       wsmb }
wsmd()  { _ts_ws_org_cd moleculardesigns wsmd }
wsar()  {
  local root; root="$(_ts_workspace)" || { echo "wsar: no workspace found" >&2; return 1 }
  [[ -d "$root/archive/github.com" ]] && { cd "$root/archive/github.com"; return 0 }
  [[ -d "$root/archive" ]] && { cd "$root/archive"; return 0 }
  echo "wsar: nothing archived on this machine yet" >&2; return 1
}

# wsj — fuzzy-jump to any repo in the tree. This is what makes the deep paths
# free: you never type them. Falls back to a numbered menu without fzf.
wsj() {
  local root d sel n i
  root="$(_ts_workspace)" || { echo "wsj: no workspace found" >&2; return 1 }
  local -a repos
  repos=("${(@f)$(find "$root"/{src,public,archive,local} -maxdepth 5 -name .git -prune 2>/dev/null \
                  | sed 's|/\.git$||' | sed "s|^$root/||" | sort)}")
  (( ${#repos[@]} )) || { echo "wsj: no repos found under $root — run 'wso plan'" >&2; return 1 }
  if command -v fzf >/dev/null 2>&1; then
    sel="$(printf '%s\n' "${repos[@]}" | fzf --height 40% --reverse \
           --query="${1:-}" --prompt 'repo> ')" || return 0
  elif [[ -n "$1" ]]; then
    local -a hits
    hits=("${(@f)$(printf '%s\n' "${repos[@]}" | grep -i -- "$1")}")
    (( ${#hits[@]} )) || { echo "wsj: no repo matching '$1'" >&2; return 1 }
    if (( ${#hits[@]} == 1 )); then sel="${hits[1]}"
    else
      for i in {1..${#hits[@]}}; do printf '%3d) %s\n' "$i" "${hits[$i]}"; done
      read -r "n?select [1]: "; sel="${hits[${n:-1}]}"
    fi
  else
    echo "wsj: fzf not installed — pass a search term, e.g. 'wsj ironcl'" >&2; return 1
  fi
  [[ -n "$sel" ]] && cd "$root/$sel"
}

# wso — workspace organizer. Thin wrapper; the work happens in the clone so the
# logic is shared with a standalone `bash bootstrap/wso.sh` invocation.
wso() {
  local cz src
  cz="$(_ts_chezmoi)" || { echo "wso: chezmoi not found on PATH." >&2; return 1 }
  src="$(_ts_src "$cz" wso)" || return 1
  TERMINAL_STACK_DIR="$src" TERMINAL_STACK_CHEZMOI="$cz" bash "$src/bootstrap/wso.sh" "$@"
}
# ---- terminal-stack-helpers-end ----

# ---- cli-tools-start ----
# PATH for ~/.local/bin is set at the top of this file, not here — the agent-CLI
# resolvers need it long before this block runs.
# fnm — Node version manager. --use-on-cd auto-switches on .nvmrc/.node-version,
# which is the whole reason to run a manager rather than a single brew node.
# Chosen over nvm because nvm costs 200-500ms of shell startup and fnm ~10ms;
# an unsourced ~/.nvm can stay where it is, this does not touch it.
command -v fnm    >/dev/null && eval "$(fnm env --use-on-cd --shell zsh 2>/dev/null)"
# grok ships completions but its installer appends them to ~/.zshrc, which this
# stack owns whole-file — chezmoi reverts that on the next apply. Carry the line
# ourselves so the completions survive. (The binary itself is routed to
# ~/.local/bin by ts_install_ai_cli, which is already on PATH above.)
[[ -d "$HOME/.grok/completions/zsh" ]] && fpath=("$HOME/.grok/completions/zsh" $fpath)
command -v zoxide >/dev/null && eval "$(zoxide init zsh)"
# fzf --zsh exists from fzf 0.48+ (March 2024); older apt fzf prints
# `unknown option: --zsh` on stderr. Redirect inside the process substitution
# so the source just no-ops on older versions.
command -v fzf    >/dev/null && source <(fzf --zsh 2>/dev/null)
# Bold blue directories in eza listings (consistent across WezTerm panes/domains).
export EZA_COLORS='di=1;34:da=1;34:ln=1;36'
command -v eza    >/dev/null && alias ls='eza --icons=always --git --group-directories-first'
command -v eza    >/dev/null && alias lt='eza --tree --icons=always --git --group-directories-first'   # matches the pwsh lt
command -v bat    >/dev/null && alias ccat='bat --paging=never'   # ccat, not cat — don't shadow real cat
alias rmf='rm -rf'   # force-delete file/folder recursively, no confirmation
# Defined unconditionally and resolved inside the body: gating the *definition*
# on `command -v cursor` meant installing Cursor's shell command mid-session left
# `c` silently undefined until a new shell. Matches the pwsh `c` function, which
# has always resolved per call.
c() {
  command -v cursor >/dev/null 2>&1 || {
    print -u2 "c: cursor CLI not found on PATH — install Cursor and enable its shell command"
    return 127
  }
  cursor "${1:-.}" --classic "${@:2}"
}

# ref — alias into the `doc` knowledge base (replaced the old command-reference file).
ref() { doc "$@"; }

# Clipboard helpers: copy stdin (or a file via catclip) to the system clipboard.
clipcopy() {
  if command -v wl-copy >/dev/null 2>&1; then
    wl-copy "$@"
  elif command -v xclip >/dev/null 2>&1; then
    xclip -selection clipboard "$@"
  elif command -v clip.exe >/dev/null 2>&1; then
    clip.exe
  elif command -v pbcopy >/dev/null 2>&1; then
    pbcopy
  else
    echo "clipcopy: no clipboard tool found: install wl-clipboard, xclip, or use WSL clip.exe" >&2
    return 1
  fi
}

catclip() {
  if [[ $# -ne 1 ]]; then
    echo "usage: catclip <file>" >&2
    return 2
  fi
  cat -- "$1" | clipcopy
}

# lsr — "list by recent": top-level directories ranked by the newest mtime among
# their immediate children (one level deep, no recursion). A directory's own mtime
# only moves when entries are added or removed, so `ls -lt` buries a project whose
# files you edited all day; lsr answers "what did I actually touch last?".
# GNU (Linux/WSL) and BSD (macOS) disagree on stat/date flags — probe once, cache.
_ts_stat_flavor() {
  if [ -z "${_TS_STAT_FLAVOR:-}" ]; then
    if stat -c %Y . >/dev/null 2>&1; then
      _TS_STAT_FLAVOR=gnu
    else
      _TS_STAT_FLAVOR=bsd
    fi
  fi
  printf '%s\n' "$_TS_STAT_FLAVOR"
}
# "epoch path" for every immediate child of $1, hidden ones included. -mindepth 1
# matters: without it find also returns $1 itself, so no directory ever looks empty
# and each one would rank on its own mtime — exactly what lsr exists to avoid.
_ts_child_times() {
  if [ "$(_ts_stat_flavor)" = gnu ]; then
    find "$1" -mindepth 1 -maxdepth 1 -exec stat -c '%Y %n' {} + 2>/dev/null
  else
    find "$1" -mindepth 1 -maxdepth 1 -exec stat -f '%m %N' {} + 2>/dev/null
  fi
}
lsr() {
  local all=0 root='.' d name newest epoch child
  while [ $# -gt 0 ]; do
    case "$1" in
      -a|--all) all=1; shift ;;
      -h|--help)
        printf '%s\n' 'lsr [-a] [dir]   top-level dirs, most recent activity first'
        printf '%s\n' '  -a, --all      include dotted directories'
        return 0 ;;
      --) shift; break ;;
      -*) echo "lsr: unknown option: $1" >&2; return 2 ;;
      *)  root="$1"; shift ;;
    esac
  done
  [ $# -gt 0 ] && root="$1"
  [ -d "$root" ] || { echo "lsr: not a directory: $root" >&2; return 1; }
  # Sort raw epochs numerically before formatting — sorting the rendered columns
  # breaks as soon as a directory name is wider than the pad.
  find "$root" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | while IFS= read -r d; do
    name=${d##*/}
    case "$name" in .*) [ "$all" -eq 1 ] || continue ;; esac
    newest=$(_ts_child_times "$d" | sort -k1,1rn | head -1)
    if [ -n "$newest" ]; then
      epoch=${newest%% *}; child=${newest#* }
      printf '%s\t%s\t%s\n' "$epoch" "$name" "${child##*/}"
    else
      printf '0\t%s\t\n' "$name"   # empty: epoch 0 sorts it last
    fi
  done | sort -k1,1rn | while IFS="$(printf '\t')" read -r epoch name child; do
    if [ "$epoch" = 0 ]; then
      printf '%-28s  %s\n' "$name" '(empty)'
    elif [ "$(_ts_stat_flavor)" = gnu ]; then
      printf '%-28s  %s  %s\n' "$name" "$(date -d "@$epoch" '+%Y-%m-%d %H:%M')" "$child"
    else
      printf '%-28s  %s  %s\n' "$name" "$(date -r "$epoch" '+%Y-%m-%d %H:%M')" "$child"
    fi
  done
}
# lsrr — lsr, capped at the 20 most recent. Takes the same flags and optional
# directory as lsr. Captures rather than piping straight into head, because a
# plain `lsr … | head` reports head's exit status and swallows lsr's errors.
lsrr() {
  local out
  out="$(lsr "$@")" || return $?
  [ -n "$out" ] && printf '%s\n' "$out" | head -20
  return 0
}
