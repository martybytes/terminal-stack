{{- $tp := "C-b" -}}{{- if hasKey . "tmuxPrefixResolved" -}}{{- $tp = .tmuxPrefixResolved -}}{{- end -}}
# Prefix key: injected from the saved terminal-stack config (default C-b).
# Change it with `tstack config tmux <chord>` (e.g. ctrl-a). Kept separate from the
# WezTerm leader so the two layers don't collide.
set -g prefix {{ $tp }}
bind {{ $tp }} send-prefix
# NOTE: `unbind C-b` is deliberately NOT here. It belongs to the ~/.tmux.conf
# wrapper only: on Omarchy C-b is kept as `prefix2` so both chords work, and
# unbinding it there would undo half of that.

# Truecolor: without these the Catppuccin hexes below get quantized to 256
# colors; RGB advertises 24-bit support for terminals matching the patterns.
set -g default-terminal "tmux-256color"
set -as terminal-features 'xterm*:RGB'
set -as terminal-features 'wezterm*:RGB'
# OSC 52: let programs inside tmux write the system clipboard (works over ssh).
set -g set-clipboard on

set -g mouse on
set -g base-index 1
setw -g pane-base-index 1
set -g renumber-windows on
set -g escape-time 10
set -g focus-events on
set -g history-limit 50000

setw -g automatic-rename on
set -g set-titles on
# The terminal tab title. tmux OWNS this while a session is attached: it
# intercepts the inner program's OSC 2 entirely and substitutes this string, so
# Claude Code's conversation slug never reaches the outer terminal at all
# (verified 2026-08-23 by capturing what tmux writes to its pty).
#
# That makes this the ONLY way to keep a project name in a Ghostty tab. Ghostty
# has a sticky per-tab title (`set_tab_title`, distinct from the surface title,
# and it does survive Claude), but it is reachable only from a keybind: there is
# no CLI to drive a running instance (`ghostty +new-window` reports "not
# supported on this platform") and no escape sequence maps to it — ConEmu's
# OSC 9;3 sets the surface title, which Claude then overwrites. WezTerm has
# `wezterm cli set-tab-title`; Ghostty has no equivalent.
#
# `s/^cc-//` strips the prefix `ccs` puts on its session names, so a tab reads
# `terminal-stack`, not `cc-terminal-stack:0.0 claude`. Sessions not named that
# way are left alone. NOTE the variable is `session_name`, not `#S`: inside
# #{...} tmux wants the variable name, and `#{s/^cc-//:#S}` silently evaluates
# to an EMPTY string — a blank tab title, which is worse than a noisy one.
set -g set-titles-string '#{s/^cc-//:session_name}'

# Claude Code passthrough: Shift+Enter and OSC notifications/progress
set -g allow-passthrough on
set -s extended-keys on
set -as terminal-features 'xterm*:extkeys'
set -as terminal-features 'wezterm*:extkeys'
