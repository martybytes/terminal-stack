# Ghostty — managed by terminal-stack. Edit the source
# (windows/AppData/Local/ghostty/config.tmpl), not this file: the Windows sync
# overwrites it (with a .bak.YYYYMMDD first).
#
# Turn the whole thing off and restore whatever was here before with
#   ts-config ghostty off
# and check what would change with `ts-config ghostty diff`.
#
# Ghostty's config syntax has no inline comments — a `#` after a value becomes
# part of the value. Every comment here is on its own line, deliberately.
#
# ── Why this path ─────────────────────────────────────────────────────────────
# There is no upstream Ghostty for Windows. What runs here is noctty
# (github.com/amanthanvi/noctty), Ghostty's terminal core in a native Win32 app,
# still shipping release assets under its former name winghostty — the rebrand
# landed in main on 2026-08-20, after the v1.3.123 tag, so no release carries the
# new name yet.
#
# It reads TWO config locations: its own %LOCALAPPDATA%\<appname>\config.ghostty,
# and the upstream-compatible %LOCALAPPDATA%\ghostty\config — this file. We
# deliberately target the upstream one. <appname> is `winghostty` today and
# `noctty` the moment the rename ships, so writing there would silently stop
# being read on upgrade day; `ghostty\` is read by both and needs no migration.
# Verified against winghostty 1.3.123. Custom themes resolve from the themes/
# subdirectory beside this file, exactly as on macOS.
#
# This is the Windows twin of dot_config/ghostty/config.tmpl — keep the shared
# directives identical; a test pins them. The differences below are the whole
# reason it is a separate file, and each one is commented.

# ── Theme ─────────────────────────────────────────────────────────────────────
# Reads the raw themeMode (not resolvedTheme), like WezTerm and the macOS twin:
# Ghostty's `dark:…,light:…` follows the OS itself, so `follow` switches live
# with no re-apply. Catppuccin Mocha is a builtin here too (486 themes ship);
# VS Code Light Modern is not, so it is shipped as themes/vs-code-light-modern.
# window-theme is Windows-only and drives the DWM title bar: pinned to match an
# explicit choice, left `auto` for follow, where the split theme already drives
# it (its own docs: with separate light/dark themes, auto behaves as system).
#
# Both values are computed by the sync from themeMode rather than branched here:
# Ghostty's config format has no conditionals, and Windows mirror files get plain
# token substitution, never Go templates (CLAUDE.md, and the sync has no template
# engine). The mapping lives once per sync path, beside the tmux-prefix token,
# which is derived the same way:
#     dark   -> Catppuccin Mocha                                  / dark
#     light  -> vs-code-light-modern                              / light
#     follow -> dark:Catppuccin Mocha,light:vs-code-light-modern  / auto
# A split theme always tracks the OS, so `follow` cannot be expressed by pinning
# window-theme, and an explicit mode cannot be expressed by a split theme.
theme = __GHOSTTY_THEME__
window-theme = __GHOSTTY_WINDOW_THEME__

# ── Font ──────────────────────────────────────────────────────────────────────
# Same face and size as WezTerm (config.font_size = 11.5), so panes look
# identical side by side.
# NOT font-thicken: that is a macOS Retina stem-darkening nicety with no effect
# on Windows DirectWrite rendering.
font-family = JetBrainsMono Nerd Font
font-size = 11.5

# ── Window ────────────────────────────────────────────────────────────────────
window-padding-x = 8
window-padding-y = 6
window-padding-balance = true
window-padding-color = extend
# NOT window-colorspace = display-p3: macOS colour management only. Windows
# renders the sRGB palette hexes as authored, which is byte-exact with WezTerm.
# Matches the macOS twin. background-blur requests the DWM system backdrop on
# Windows 11 22H2+ and is accepted-but-inert below that; the number is treated
# as on/off rather than a radius, and is kept at 20 only to match the twin.
background-opacity = 0.97
background-blur = 20
# Windows restores window rect, tabs, splits, profiles, cwds and titles — not
# terminal contents or child processes. Same line, narrower promise than macOS.
window-save-state = always

# ── Cursor ────────────────────────────────────────────────────────────────────
cursor-style = block
cursor-style-blink = false
mouse-hide-while-typing = true

# ── Keys ──────────────────────────────────────────────────────────────────────
# The macOS twin sets macos-option-as-alt and three cmd+… readline chords. None
# of that applies here: there is no Cmd key, Alt already reaches the application
# on Windows, and Home/End/Ctrl+U are the native equivalents of those chords.
# macos-option-as-alt is not merely useless here — it is absent from this build's
# option set. It is silently ignored rather than diagnosed, so shipping it would
# be harmless but dishonest.
#
# Defaults are left alone for the same reason as on macOS: this stack multiplexes
# INSIDE the terminal with WezTerm and tmux, so Ctrl+Shift+T/W/E and the rest are
# working keys with nothing to forward them to.

# ── Behaviour ─────────────────────────────────────────────────────────────────
copy-on-select = clipboard
clipboard-paste-protection = true
clipboard-trim-trailing-spaces = true
# Matches WezTerm's config.scrollback_lines = 10000.
scrollback-limit = 10000
mouse-scroll-multiplier = 2
link-url = true
# The macOS twin sets `off` because Homebrew installs the cask and two updaters
# fighting over /Applications is how you get a half-replaced bundle. Nothing owns
# the install here — it comes from the GitHub releases page — so the app's own
# updater IS the update path. `check` notifies without downloading or applying;
# raise to `download` if you want it staged (it verifies SHA-256 + Authenticode
# and still waits for a click), or `off` if you track releases yourself.
auto-update = check
# no-cursor: the shell already manages cursor shape via the prompt, and letting
# both do it makes the cursor flicker between styles.
shell-integration-features = no-cursor,sudo,title
