# terminal-stack git config — pulled in via `include.path` from ~/.gitconfig
# (the bootstrap adds the include once; user-specific settings like user.email
# stay in ~/.gitconfig itself and always win, since includes resolve first).
#
# Canonical copy: dot_config/git/terminal-stack.gitconfig.
# windows/.config/git/terminal-stack.gitconfig is a byte-identical mirror —
# edit the canonical file, then copy it over (same convention as starship.toml).

[alias]
	st = status
	lg = log --oneline --graph --decorate -10
	lga = log --oneline --graph --decorate --all
	br = branch
	co = checkout
	cm = commit

# delta: side-by-side syntax-highlighted diffs. Guarded: on a machine without
# delta (app picker skipped, TS_APPS=none) the pager falls back to less/cat
# instead of erroring on every `git diff`. Git runs pager values through sh on
# all platforms (Git for Windows ships sh + less), so the guard is portable.
[core]
	pager = "sh -c 'if command -v delta >/dev/null 2>&1; then delta; else less -R; fi'"

[interactive]
	diffFilter = "sh -c 'if command -v delta >/dev/null 2>&1; then delta --color-only; else cat; fi'"

[delta]
	navigate = true

# Typo recovery: `git pulll` offers the corrected command and waits for a
# y/n instead of erroring. `prompt` needs git ≥ 2.40 (all bootstrap targets
# ship newer); pre-2.40 git fatals on the non-numeric value when a typo'd
# command triggers the lookup — drop to an integer (deciseconds) if you must
# support one.
[help]
	autocorrect = prompt

# Fast-forward-only pulls. The single most valuable line here once a machine
# holds ~100 repos: `git pull` either fast-forwards cleanly or refuses and
# leaves you exactly where you were. It can never manufacture a surprise merge
# commit, and it can never half-merge over uncommitted work — so a bulk update
# pass (`wso sync`) is safe by construction, and the repos it skips are the
# short list that actually needs a human. Use `git pull --rebase` or an
# explicit `git merge` when you genuinely want to reconcile a divergence.
[pull]
	ff = only
