-- ~/.wezterm.lua (Windows) — terminal-stack WezTerm config.
-- Structure: theme palettes → base options → QoL (quick select, hyperlinks) →
-- keys/key_tables → plugins (sessionizer, resurrect; each pcall-guarded) →
-- tab titles + Claude cc_state rendering → pane background tint → status bar
-- (mode badge, Claude fleet, workspace/detail; never a clock) → pane_nav
-- (F1..F6 directional nav-or-split).
-- Keep visual settings + keys in sync with dot_wezterm.lua.tmpl (macOS).
--
-- This file is a template: the leader chord and theme mode are injected from the
-- saved terminal-stack config (__LEADER_KEY__ / __LEADER_MODS__ / __THEME_MODE__)
-- by the Windows sync (run_after_90-sync-windows.sh or scripts/sync-windows.ps1).
-- Change them with `ts-config leader <chord>` / `ts-config theme <mode>`.

local wezterm = require 'wezterm'
local act = wezterm.action
local pane_nav = require 'pane_nav'
local config = wezterm.config_builder()

config.default_prog = { 'pwsh.exe', '-NoLogo' }

config.launch_menu = {
  { label = 'PowerShell 7',         args = { 'pwsh.exe', '-NoLogo' } },
  { label = 'WSL zsh',              args = { 'wsl.exe', '--cd', '~', '-e', 'zsh', '-l' } },
  -- Plain variants: no profile / no rc files — escape hatch when the stack misbehaves.
  { label = 'PowerShell 7 (plain)', args = { 'pwsh.exe', '-NoLogo', '-NoProfile' } },
  { label = 'WSL zsh (plain)',      args = { 'wsl.exe', '--cd', '~', '-e', 'zsh', '-df' } },
}

config.ssh_domains = wezterm.default_ssh_domains()
for _, dom in ipairs(config.ssh_domains) do
  dom.assume_shell = 'Posix'
end

-- Optional: host panes in a multiplexer process outside the GUI, so losing the
-- GUI does not kill the shells. Motivation: the WebGpu panic documented at
-- config.front_end below took out three live Claude Code sessions on 2026-08-18.
-- With a mux domain a GUI crash leaves every pane (and everything running in it)
-- alive; relaunching WezTerm reattaches.
--
-- OFF by default, because the mux has real costs: the mux server loads its OWN
-- copy of this file, so config that affects pane spawning needs a mux restart
-- (which kills every pane) and not just a GUI reload; and pane background tints
-- (below) need pane:inject_output, which is local-pane-only — mux panes fall
-- back to the hook's raw OSC 11, which ConPTY eats on Windows, so per-pane tints
-- may not render. Failures are logged (Ctrl+Shift+L).
--
-- Toggle with `ts-mux on` / `ts-mux off`; `ts-mux -h` also has status / kill /
-- restart / reset. __WEZ_MUX__ is injected by the Windows sync from the saved
-- config key `weztermMux`.
local MUX_ENABLED = '__WEZ_MUX__' == 'on'
if MUX_ENABLED then
  config.unix_domains = { { name = 'main' } }
  config.default_domain = 'main'
end

-- Optional: reopen the last session at GUI start — the tabs, panes, layout and
-- scrollback you had when you last closed WezTerm. OFF by default: a terminal
-- that silently reopens yesterday's shells is a surprise rather than a feature,
-- and the autosave below keeps Leader+L available whenever you do want it back.
-- Toggle with `ts-config restore on` / `off`.
local RESTORE_ENABLED = '__WEZ_RESTORE__' == 'on'

