  -- app by default, so the app-level keybinding (keybindings.json) alone can't fire.
  { key = 'Enter', mods = 'SHIFT', action = act.SendString '\n' },
}

-- ── Identity helpers (status bar user@host + path, from the *active pane*) ────
-- OSC 7, shell-integration user vars, SSH/WSL domain, then pane title — not the
-- WezTerm GUI process.
local function titlecase(s)
  if not s or s == '' then return '' end
  return s:sub(1, 1):upper() .. s:sub(2):lower()
end

local function hostname_short(h)
  if not h or h == '' or h == 'localhost' then return '' end
  local dot = h:find('[.]')
  if dot then h = h:sub(1, dot - 1) end
  return h
end

local function identity_from_title(title)
  if not title or title == '' then return nil, nil end
  local user, host = title:match('^([%w%-_]+)@([%w%-_]+)')
  if user and host then return user, host end
  host = title:match('^([^:%s]+):')
  if host and host ~= '' and not host:find('[%./\\]') then return nil, host end
  return nil, nil
end

local function path_from_title(title)
  if not title or title == '' then return '' end
  -- A bare Windows path ('C:\Users\x') IS the path — don't split on its drive colon.
  if title:match('^%a:[/\\]') then return title end
  -- Otherwise take what follows the first ': ' separator ('host: /some/path'),
  -- falling back to the last colon for legacy 'host:path' titles.
  local path = title:match(':%s+(.*)$') or title:match('.*:[%s]*(.*)$')
  if not path then return '' end
  path = path:gsub('^%s+', ''):gsub('%s+$', '')
  return path
end

local function pane_title(pane)
  local title = pane.title
  if (not title or title == '') and pane.get_title then title = pane:get_title() end
  return title or ''
end

local function identity_from_domain(domain)
  if not domain or domain == '' then return nil, nil end
  local label = domain:match('^SSH:(.+)$') or domain:match('^WSL:(.+)$')
  if not label then return nil, nil end
  local user, host = label:match('^([^@]+)@([^:]+)')
  if user and host then return user, host end
  return nil, label:gsub(':%d+$', '')
end

local function pane_location(pane)
  local user, host, path = '', '', ''

  local uv = pane.user_vars
  if uv then
    if uv.WEZTERM_USER and uv.WEZTERM_USER ~= '' then user = uv.WEZTERM_USER end
    if uv.WEZTERM_HOST and uv.WEZTERM_HOST ~= '' then host = uv.WEZTERM_HOST end
  end

  local cwd_uri = pane:get_current_working_dir()
  if not cwd_uri and pane.current_working_dir then cwd_uri = pane.current_working_dir end
  if cwd_uri then
    if type(cwd_uri) == 'userdata' then
      path = cwd_uri.file_path or ''
      if cwd_uri.username and cwd_uri.username ~= '' then user = cwd_uri.username end
      local h = hostname_short(cwd_uri.host)
      if h ~= '' then host = h end
    else
      local s = tostring(cwd_uri)
      if s:sub(1, 7) == 'file://' then
        s = s:sub(8)
        local slash = s:find('/')
        if slash then
          host = hostname_short(s:sub(1, slash - 1))
          path = s:sub(slash):gsub('%%(%x%x)', function(hex)
            return string.char(tonumber(hex, 16))
          end)
        end
      else
        path = s
      end
    end
  end

  if host == '' or user == '' then
    local du, dh = identity_from_domain(pane:get_domain_name())
    if dh and host == '' then host = dh end
    if du and user == '' then user = du end
  end

  if host == '' or user == '' then
    local title = pane_title(pane)
    local tu, th = identity_from_title(title)
    if th and host == '' then host = th end
    if tu and user == '' then user = tu end
  end

  if path == '' then
    path = path_from_title(pane_title(pane))
  end

  if host == '' then host = hostname_short(wezterm.hostname() or '') end
  if user == '' then user = os.getenv('USERNAME') or os.getenv('USER') or '' end

  return titlecase(user), titlecase(host), path
end

-- The workspace name for the status bar; '' for the implicit 'default'
-- workspace, which names nothing. Always visible — a non-default workspace is a
-- deliberate context worth a permanent slot (the Leader+s toggle only gates the
-- identity/path segment).
local function status_workspace(window)
  local ws = window:active_workspace()
  if ws == nil or ws == '' or ws == 'default' then return '' end
  return ws
end

-- ── Plugins: sessionizer (Leader+p), resurrect (Leader+S/L) ───────────────────
-- Both are pinned forks under github.com/martybytes (upstream archival can't
-- break us; update by pulling upstream into the fork deliberately). Each load is
-- pcall-guarded: a clone failure logs and only that binding is lost.
-- (tabline.wez was dropped when the bar went hand-rolled — see docs/decisions.md
-- § "Why the tab bar is fancy and fully hand-rolled".)
-- Plugins load only in the GUI process (wezterm.gui is nil in the mux server).
if wezterm.gui then
  -- sessionizer.wezterm: Leader+p fuzzy project picker over the wso workspace
  -- layout (<workspace>/<tier>/github.com/<owner>/<repo>) plus suffix siblings.
  -- Needs `fd` on PATH for repo discovery.
  local sok, sessionizer = pcall(wezterm.plugin.require, 'https://github.com/martybytes/sessionizer.wezterm')
  if sok and sessionizer then
    local function workspace_roots()
      local candidates = {}
      for _, env in ipairs { 'WORKSPACE_DIR', 'WORK_WORKSPACE_DIR' } do
        local v = os.getenv(env)
        if v and #v > 0 then table.insert(candidates, (v:gsub('\\', '/'))) end
      end
      table.insert(candidates, 'C:/DATA/Workspace')
      local home = wezterm.home_dir:gsub('\\', '/')
      table.insert(candidates, home .. '/workspace')
      table.insert(candidates, home .. '/Documents/Workspace')
      local roots, seen = {}, {}
      for _, c in ipairs(candidates) do
        for _, suffix in ipairs { '', '_Personal', '-Personal', '_Public', '-Public', '_Work', '-Work' } do
          local p = c .. suffix
          if not seen[p] and #wezterm.glob(p) > 0 then
            seen[p] = true
            table.insert(roots, p)
          end
        end
      end
      return roots
    end
    local schema = {
      options = { title = 'Projects', prompt = 'Project: ' },
      sessionizer.DefaultWorkspace {},
      sessionizer.AllActiveWorkspaces {},
    }
    for _, root in ipairs(workspace_roots()) do
      table.insert(schema, sessionizer.FdSearch { root, max_depth = 6 })
    end
    schema.processing = sessionizer.for_each_entry(function(entry)
      entry.label = entry.label:gsub('\\', '/'):gsub('^.*/([^/]+/[^/]+/[^/]+)$', '%1')
    end)
    table.insert(config.keys, { key = 'p', mods = 'LEADER', action = sessionizer.show(schema) })
  else
    wezterm.log_error('sessionizer plugin unavailable: ' .. tostring(sessionizer))
  end

  -- resurrect.wezterm (maintained fork): session save/restore across restarts.
  -- Autosave every 15 min + on focus loss; Leader+S saves the workspace now,
  -- Leader+L fuzzy-restores a saved state on demand. No encryption (Windows
  -- stdin caveat). Reopening the last session automatically at GUI start is a
  -- separate thing and is OFF by default — see RESTORE_ENABLED above.
  local rok, resurrect = pcall(wezterm.plugin.require, 'https://github.com/martybytes/resurrect.wezterm')
  if rok and resurrect then
    local setup2_ok, setup2_err = pcall(function()
      -- Deliberately NOT resurrect.setup(): that helper registers
      --   wezterm.on('gui-startup', state_manager.resurrect_on_gui_startup)
      -- unconditionally, with no opt-out, and reopening the last session is
      -- exactly what RESTORE_ENABLED gates. Everything else setup() would do for
      -- us is these two save engines — its status bar and default keybindings we
      -- already turned off, and we pass no restore_delay/safe_restore_processes.
      resurrect.state_manager.event_driven_save {
        save_workspaces = true, save_windows = true, save_tabs = true,
        save_on_focus_loss = true,
      }
      resurrect.state_manager.periodic_save {
        interval_seconds = 900,
        save_workspaces = true, save_windows = true, save_tabs = true,
      }
      if RESTORE_ENABLED then
        wezterm.on('gui-startup', resurrect.state_manager.resurrect_on_gui_startup)
      end
    end)
    if setup2_ok then
      table.insert(config.keys, { key = 'S', mods = 'LEADER', action = resurrect.workspace_state.save_workspace_action() })
      table.insert(config.keys, { key = 'L', mods = 'LEADER', action = resurrect.fuzzy_loader.restore_action() })
    else
      wezterm.log_error('resurrect setup failed: ' .. tostring(setup2_err))
    end
  else
    wezterm.log_error('resurrect plugin unavailable: ' .. tostring(resurrect))
  end
end

-- ── Tab labels: " <idx>  <icon> [host ·] <title>  <dots|count> " ──────────────
-- Title precedence: tab.tab_title (set by the cc wrappers / Claude hooks via
-- `wezterm cli set-tab-title` — sticky, survives the TUI overwriting pane.title),
-- then the active pane's cwd leaf, then the leaf of whatever path the pane title
-- carries. Labels are deliberately short: Claude panes show the bare project
-- name (the wrappers/hooks no longer prefix 'cc' — the icon and dots already say
-- Claude), everything else is reduced to its directory leaf, never a full path.
-- Remote panes get a host chip ( host ·) from OSC 7 / the SSH domain / a
-- 'host: path' title.
-- Per-pane Claude state comes from the `cc_state` user var the wez-tab-status
-- hook sets (working/done/error, cleared on exit): a coloured dot per pane, the
-- tab background washed by the most urgent state (error > done > working) and
-- the label tinted to match while unfocused — so a background Claude run is
-- obvious at a glance. The ACTIVE tab always keeps the solid accent block (its
-- one job is to be findable); its dots still carry the Claude state. Inactive
-- tabs with unseen output get an accent dot. Nerd-font lookups are fallback-
-- guarded (unknown names resolve to nil) so a missing glyph can't break the bar.
local PROC_ICONS = {
  pwsh = wezterm.nerdfonts.md_powershell, powershell = wezterm.nerdfonts.md_powershell,
  zsh = wezterm.nerdfonts.md_console, bash = wezterm.nerdfonts.md_console,
  sh = wezterm.nerdfonts.md_console, wsl = wezterm.nerdfonts.md_console,
  wslhost = wezterm.nerdfonts.md_console,
  nvim = wezterm.nerdfonts.custom_vim, vim = wezterm.nerdfonts.custom_vim,
  git = wezterm.nerdfonts.dev_git, lazygit = wezterm.nerdfonts.dev_git,
  node = wezterm.nerdfonts.md_nodejs, deno = wezterm.nerdfonts.md_nodejs,
  python = wezterm.nerdfonts.md_language_python, python3 = wezterm.nerdfonts.md_language_python,
  cargo = wezterm.nerdfonts.dev_rust, rustc = wezterm.nerdfonts.dev_rust,
  go = wezterm.nerdfonts.md_language_go,
  docker = wezterm.nerdfonts.md_docker, kubectl = wezterm.nerdfonts.md_kubernetes,
  tmux = wezterm.nerdfonts.cod_terminal_tmux,
  micro = wezterm.nerdfonts.md_pencil, nano = wezterm.nerdfonts.md_pencil,
}
local ICON_CLAUDE   = wezterm.nerdfonts.md_robot or '*'
local ICON_FALLBACK = wezterm.nerdfonts.md_console or '>'
local ICON_ZOOM     = wezterm.nerdfonts.md_fullscreen or 'Z'
local ICON_REMOTE   = wezterm.nerdfonts.md_remote_desktop or wezterm.nerdfonts.md_lan_connect or '@'
local TAB = {  -- derived from the active palette
  text = P.text, inactive = P.subtext0, dim = P.overlay1,
  working = P.peach, done = P.green, error = P.maroon,
}

local function dir_leaf(pane)
  local cwd = pane.current_working_dir
  if not cwd then return nil end
  local p = (type(cwd) == 'userdata' and cwd.file_path) or tostring(cwd)
  p = p:gsub('^file://[^/]*', ''):gsub('[/\\]+$', '')
  return p:match('[^/\\]+$')
end

local function proc_leaf(pane)
  local name = pane.foreground_process_name
  if not name or name == '' then return nil end
  return (name:gsub('[/\\]+$', ''):match('[^/\\]+$') or name):gsub('%.exe$', ''):lower()
end

-- Claude state from a pane's user var: 'working'|'done'|'error' or nil.
local function pane_cc(pane)
  local s = pane.user_vars and pane.user_vars.cc_state
  if s == nil or s == '' then return nil end
  return s
end

-- This machine's short hostname, lowercased — panes that resolve to it (or to
-- localhost) get no host chip. WSL panes report this machine's name via OSC 7,
-- so they stay chip-free too.
local LOCAL_HOST = (function()
  local h = wezterm.hostname() or ''
  local dot = h:find('[.]')
  if dot then h = h:sub(1, dot - 1) end
  return h:lower()
end)()

-- Remote host for the tab chip: OSC 7 host, else the SSH domain, else a
-- 'host: path' pane title; '' when the pane is (or looks) local.
local function tab_remote_host(pane)
  local host = ''
  local cwd = pane.current_working_dir
  if cwd and type(cwd) == 'userdata' and cwd.host and cwd.host ~= '' then
    host = cwd.host
  end
  if host == '' then
    local dom = pane.domain_name or ''
    local label = dom:match('^SSH:(.+)$') or dom:match('^SSHMUX:(.+)$')
    if label then host = label:gsub('^[^@]+@', ''):gsub(':%d+$', '') end
  end
  if host == '' then
    host = (pane.title or ''):match('^([%w%-_]+):%s') or ''
  end
  -- Trim a DNS suffix, but never dot-split an IP address.
  if not host:match('^%d[%d.]*$') then
    local dot = host:find('[.]')
    if dot then host = host:sub(1, dot - 1) end
  end
  if host == '' or host:lower() == LOCAL_HOST or host == 'localhost' then return '' end
  return host
end

-- Strip a legacy Claude prefix ('cc • x' / 'cc-x' / 'cc ⚙ x') from a stored tab
-- title. The wrappers/hooks now set the bare project name; this keeps titles
-- from not-yet-updated machines rendering clean too.
local function strip_cc_prefix(s)
  local rest = s:match('^[cC][cC](.*)$')
  if not rest or rest == '' then return s end
  if rest:sub(1, 1):match('%w') then return s end   -- 'ccsomething' is a real name
  rest = rest:gsub('^[^%w~/\\.]+', '')
  if rest ~= '' then return rest end
  return s
end

-- The label + host chip for a tab. Explicit titles win; otherwise the active
-- pane's cwd leaf; otherwise the leaf of whatever path the pane title carries.
local function tab_label(tab)
  local active = tab.active_pane
  local t = tab.tab_title
  if t and #t > 0 then
    local sshspec = t:match('^ssh%-(.+)$')   -- ssht sets 'ssh-<host>:<session>'
    if sshspec then
      local host = sshspec:match('^([^:]+)') or sshspec
      local sess = sshspec:match(':(.+)$')
      return ((sess and sess ~= 'main') and sess or host), host
    end
    return strip_cc_prefix(t), tab_remote_host(active)
  end
  local host = tab_remote_host(active)
  local leaf = dir_leaf(active)
  if leaf then return leaf, host end
  local pathleaf = path_from_title(active.title or ''):gsub('[/\\]+$', ''):match('[^/\\]+$')
  if pathleaf and #pathleaf > 0 then return pathleaf, host end
  return active.title or '', host
end

wezterm.on('format-tab-title', function(tab, tabs, panes, cfg, hover, max_width)
  local active = tab.active_pane
  local label, rhost = tab_label(tab)
  label = wezterm.truncate_right(label, 28)

  -- icon: Claude (by user var), else remote, else the foreground process.
  local icon
  if pane_cc(active) then
    icon = ICON_CLAUDE
  elseif rhost ~= '' then
    icon = ICON_REMOTE
  else
    local p = proc_leaf(active)
    icon = (p and PROC_ICONS[p]) or ICON_FALLBACK
  end

  -- per-pane dots + aggregate state; note zoom and unseen output.
  local dots, agg, any_cc, zoomed, unseen = {}, nil, false, false, false
  for _, p in ipairs(tab.panes) do
    local s = pane_cc(p)
    if s then
      any_cc = true
      table.insert(dots, { c = TAB[s] or TAB.dim, g = '●', st = true })
      if s == 'error' then agg = 'error'
      elseif s == 'done' and agg ~= 'error' then agg = 'done'
      elseif s == 'working' and not agg then agg = 'working' end
    else
      table.insert(dots, { c = TAB.dim, g = '○', st = false })
    end
    if p.is_zoomed then zoomed = true end
    if p.has_unseen_output then unseen = true end
  end

  -- The active tab keeps its solid accent block (bg comes from colors.tab_bar);
  -- inactive tabs are dim, background-washed by the cc tint when Claude has state.
  local fg
  if tab.is_active then
    fg = P.tab_bar.active_tab.fg_color
  elseif agg then
    fg = TAB[agg]
  else
    fg = P.tab_bar.inactive_tab.fg_color
  end
  local bold = tab.is_active or agg ~= nil

  local items = {}
  if not tab.is_active and agg then
    table.insert(items, { Background = { Color = P['cc_' .. agg] } })
  end
  table.insert(items, { Attribute = { Intensity = bold and 'Bold' or 'Normal' } })
  table.insert(items, { Foreground = { Color = fg } })
  table.insert(items, { Text = ' ' .. (tab.tab_index + 1) .. '  ' .. icon .. '  ' })
  if rhost ~= '' and rhost ~= label then
    table.insert(items, { Text = rhost .. ' · ' })
  end
  table.insert(items, { Text = label .. ' ' })
  if any_cc then                         -- dots imply the pane count
    table.insert(items, { Text = ' ' })
    for _, d in ipairs(dots) do
      -- On the accent block, empty dots take the tab fg so they stay visible.
      table.insert(items, { Foreground = { Color = (tab.is_active and not d.st) and fg or d.c } })
      table.insert(items, { Text = d.g })
    end
  elseif #tab.panes > 1 then
    table.insert(items, { Foreground = { Color = tab.is_active and fg or TAB.dim } })
    table.insert(items, { Text = ' ' .. #tab.panes })
  end
  if zoomed then
    table.insert(items, { Foreground = { Color = tab.is_active and fg or TAB.dim } })
    table.insert(items, { Text = ' ' .. ICON_ZOOM })
  end
  if unseen and not tab.is_active and not any_cc then
    table.insert(items, { Foreground = { Color = P.accent } })
    table.insert(items, { Text = ' ●' })
  end
  table.insert(items, { Text = ' ' })
  return items
end)

-- ── Per-pane background + Claude tint (ConPTY-proof) ────────────────────────
-- The hook also emits an OSC 11 background tint, but on Windows ConPTY eats OSC
-- 10/11/12 before they reach WezTerm (the cc_state user var survives because
-- ConPTY passes the unknown OSC 1337 through verbatim — that's why the tab dots
-- work but the pane never tinted). Re-drive from cc_state + focus here:
-- user-var-changed fires reliably, and pane:inject_output feeds the OSC 11 into
-- WezTerm's own emulator, bypassing ConPTY entirely. Local panes only —
-- inject_output is unavailable on mux/SSH panes, so with default_domain='main'
-- the tint may not render; failures log to the debug overlay (Ctrl+Shift+L). See
-- docs/powershell-quirks.md § "ConPTY swallows the OSC 11 pane background tint".
local CC_BG = { working = P.cc_working, done = P.cc_done, error = P.cc_error }
local pane_bg_applied = {}
local pane_bg_logged = {}

local function pane_cc_state(pane)
  local s = pane.user_vars and pane.user_vars.cc_state
  if s == nil or s == '' then return nil end
  return s
end

local function pane_bg_color(pane, is_active)
  local cc = pane_cc_state(pane)
  if cc and CC_BG[cc] then return CC_BG[cc] end
  return is_active and P.pane_active or P.pane_inactive
end

local function clear_pane_bg_cache()
  for k in pairs(pane_bg_applied) do pane_bg_applied[k] = nil end
end

local function inject_pane_surface(p, bg)
  -- Background only (OSC 11). Do not inject OSC 10 — it fights ANSI/eza colours and
  -- makes listing colours diverge between panes/domains.
  local ok, err = pcall(function()
    p:inject_output('\x1b]11;' .. bg .. '\x07')
  end)
  if not ok then
    local pid = p:pane_id()
    if not pane_bg_logged[pid] then
      pane_bg_logged[pid] = true
      wezterm.log_error('pane tint: inject_output failed for pane ' .. tostring(pid)
        .. ' (mux/remote pane?): ' .. tostring(err))
    end
  end
end

local function sync_pane_backgrounds(window, force)
  local mux_win = window:mux_window()
  if not mux_win then return end
  for _, tab in ipairs(mux_win:tabs()) do
    local active = tab:active_pane()
    local active_id = active and active:pane_id()
    for _, p in ipairs(tab:panes()) do
      local pid = p:pane_id()
      local bg = pane_bg_color(p, pid == active_id)
      if force or pane_bg_applied[pid] ~= bg then
        pane_bg_applied[pid] = bg
        inject_pane_surface(p, bg)
      end
    end
  end
end

wezterm.on('user-var-changed', function(window, pane, name, value)
  if name ~= 'cc_state' then return end
  sync_pane_backgrounds(window, true)
end)

wezterm.on('window-config-reloaded', function(window)
  clear_pane_bg_cache()
  sync_pane_backgrounds(window, true)
end)

-- ── Status bar: mode badge (left) · fleet / workspace / detail (right) ────────
-- Hand-rolled (tabline.wez was dropped — its permanent 'NORMAL' mode badge is
-- exactly what this bar must not show). The left badge appears ONLY while
-- something is pending — leader held, or a repeatable mode live — and names
-- itself in the mode's colour; the normal state renders nothing there. The right
-- side is segments: the Claude fleet (every cc pane in the mux, counted by
-- state), the non-default workspace, and the Leader+s identity/path detail.
-- Time is intentionally never rendered. Pane tints ride the same cadence.
local MODE_BADGE = {
  move_mode   = { label = '✛ MOVE ↑↓←→',   color = P.accent },
  resize_mode = { label = '⤢ RESIZE ↑↓←→', color = P.peach },
  rotate_mode = { label = '⟳ ROTATE ←→',   color = P.teal },
  tab_mode    = { label = '⇥ TAB ←→',      color = P.green },
  font_mode   = { label = 'A± FONT ↑↓0',   color = P.lavender },
}
local ICON_WORKSPACE = wezterm.nerdfonts.cod_window or '⬡'
local ICON_USER      = wezterm.nerdfonts.md_account or '@'
local ICON_PATH      = wezterm.nerdfonts.md_folder_outline or '/'
local ICON_MUTE      = wezterm.nerdfonts.md_volume_off or 'x'

-- The TTS mute, as the tray icon, the global hotkey and `ccmute` all write it: one
-- sentinel file. Read at most once a second on purpose -- update-status fires at 10 Hz,
-- and a child process in that handler would stall the UI outright (a stat will not).
-- A forgotten mute is the failure mode this chip exists to prevent: without it, silence
-- looks exactly like broken TTS.
local MUTE_SENTINEL = (function()
  local base = os.getenv('LOCALAPPDATA')
  if not base then return nil end
  return base .. '\\terminal-stack\\tts-daemon\\state\\muted'
end)()
local mute_cache = { at = 0, muted = false }

local function tts_muted()
  if not MUTE_SENTINEL then return false end
  local now = os.time()
  if now - mute_cache.at >= 1 then
    mute_cache.at = now
    local handle = io.open(MUTE_SENTINEL, 'r')
    mute_cache.muted = handle ~= nil
    if handle then handle:close() end
  end
  return mute_cache.muted
end

local function left_badge(window)
  local kt = window:active_key_table()
  local label, color
  if kt then
    local m = MODE_BADGE[kt]
    label = (m and m.label or kt) .. ' · Esc'
    color = m and m.color or P.accent
  elseif window:leader_is_active() then
    label, color = '⌨ LEADER', P.peach
  end
  if not label then return '' end
  return wezterm.format {
    { Background = { Color = color } },
    { Foreground = { Color = P.tab_bar.background } },
    { Attribute = { Intensity = 'Bold' } },
    { Text = '  ' .. label .. '  ' },
  }
end

-- Claude fleet: cc_state across every pane in every mux window — answers "is
-- anything done or broken?" without scanning the tabs.
local function cc_fleet_counts()
  local counts = { working = 0, done = 0, error = 0 }
  local total = 0
  for _, w in ipairs(wezterm.mux.all_windows()) do
    for _, t in ipairs(w:tabs()) do
      for _, p in ipairs(t:panes()) do
        local ok, uv = pcall(function() return p:get_user_vars() end)
        local s = ok and uv and uv.cc_state or nil
        if s and counts[s] then
          counts[s] = counts[s] + 1
          total = total + 1
        end
      end
    end
  end
  return counts, total
end

-- '…/last/three/segments' — a long path never eats the bar.
local function shorten_path(path)
  if not path or path == '' then return '' end
  local segs = {}
  for seg in path:gmatch('[^/\\]+') do table.insert(segs, seg) end
  if #segs <= 3 then return path end
  return '…/' .. segs[#segs - 2] .. '/' .. segs[#segs - 1] .. '/' .. segs[#segs]
end

wezterm.on('update-status', function(window, pane)
  sync_pane_backgrounds(window)
  window:set_left_status(left_badge(window))

  local items = {}
  local function sep()
    if #items > 0 then
      table.insert(items, { Foreground = { Color = P.overlay0 } })
      table.insert(items, { Attribute = { Intensity = 'Normal' } })
      table.insert(items, { Text = '  │  ' })
    end
  end

  if tts_muted() then
    sep()
    table.insert(items, { Foreground = { Color = P.maroon } })
    table.insert(items, { Attribute = { Intensity = 'Bold' } })
    table.insert(items, { Text = ICON_MUTE .. ' MUTED' })
    table.insert(items, { Attribute = { Intensity = 'Normal' } })
  end

  local counts, total = cc_fleet_counts()
  if total > 0 then
    sep()
    table.insert(items, { Foreground = { Color = TAB.dim } })
    table.insert(items, { Text = ICON_CLAUDE .. ' ' })
    local first = true
    for _, s in ipairs { 'working', 'done', 'error' } do
      if counts[s] > 0 then
        if not first then table.insert(items, { Text = ' ' }) end
        first = false
        table.insert(items, { Foreground = { Color = TAB[s] } })
        table.insert(items, { Attribute = { Intensity = 'Bold' } })
        table.insert(items, { Text = counts[s] .. '●' })
        table.insert(items, { Attribute = { Intensity = 'Normal' } })
      end
    end
  end

  local ws = status_workspace(window)
  if ws ~= '' then
    sep()
    table.insert(items, { Foreground = { Color = P.accent } })
    table.insert(items, { Text = ICON_WORKSPACE .. ' ' .. ws })
  end

  if wezterm.GLOBAL.show_identity then
    local pu, ph, ppath = pane_location(pane)
    local identity = (#pu > 0 and #ph > 0) and (pu .. '@' .. ph) or (pu .. ph)
    if identity ~= '' then
      sep()
      table.insert(items, { Foreground = { Color = P.teal } })
      table.insert(items, { Text = ICON_USER .. ' ' .. identity })
    end
    local short = shorten_path(ppath)
    if short ~= '' then
      sep()
      table.insert(items, { Foreground = { Color = TAB.inactive } })
      table.insert(items, { Text = ICON_PATH .. ' ' .. short })
    end
  end

  window:set_right_status(wezterm.format(items))
end)

-- ── Dim every pane while the window is unfocused ──────────────────────────────
-- inactive_pane_hsb dims unfocused panes within a focused window; on blur we want
-- a uniform dim across all panes, so we dim all text (foreground_text_hsb) and
-- cancel the per-pane inactive dim. On focus we drop both overrides.
wezterm.on('window-focus-changed', function(window)
  local o = window:get_config_overrides() or {}
  if window:is_focused() then
    o.foreground_text_hsb = nil
    o.inactive_pane_hsb   = nil
    sync_pane_backgrounds(window, true)
  else
    o.foreground_text_hsb = { brightness = 0.35, saturation = 0.8, hue = 1.0 }
    o.inactive_pane_hsb   = { brightness = 1.0, saturation = 1.0, hue = 1.0 }
  end
  window:set_config_overrides(o)
end)

-- Leader, Esc cancels a pending leader (a no-op consumes Esc; with the
-- ~no-timeout leader this is the deliberate way to back out).
table.insert(config.keys, { key = 'Escape', mods = 'LEADER', action = wezterm.action_callback(function() end) })

-- Alt+1..9 → activate tab by number (appended to the literal config.keys above).
for i = 1, 9 do
  table.insert(config.keys, { key = tostring(i), mods = 'ALT', action = act.ActivateTab(i - 1) })
end

-- ── Repeatable leader modes (key tables) ─────────────────────────────────────
-- Entered from the arrow / t / f bindings above; inside a mode plain arrows or
-- j/k/i/m repeat. Every mode auto-exits (until_unknown + timeout); Esc/Enter
-- leave immediately. Names end in _mode so the status badge colours them per mode.
-- The SHIFT/CTRL arrow duplicates are deliberate: after entering a mode you are
-- often still holding the modifier — the modified press must keep repeating.
config.key_tables = {
