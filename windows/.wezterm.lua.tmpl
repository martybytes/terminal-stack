-- ── QoL: quick select, hyperlinks, prompt jumping ─────────────────────────────
-- QuickSelect (Ctrl+Shift+Space): hint-label anything matching these patterns in
-- the viewport and copy it — plus the built-in URL/path/hash defaults.
config.quick_select_patterns = {
  '[0-9a-f]{7,40}',            -- git SHAs
  '[A-Za-z0-9._/-]+:[0-9]+',   -- file:line refs
}

-- Hyperlinks: keep the defaults (URLs), add `owner/repo` → GitHub and
-- `path/to/file.ext:line` → Cursor (via the open-uri handler below).
config.hyperlink_rules = wezterm.default_hyperlink_rules()
table.insert(config.hyperlink_rules, {
  regex = [=[["'\s]([\w-]+/[\w.-]+)["'\s]]=],
  format = 'https://www.github.com/$1',
  highlight = 1,
})
table.insert(config.hyperlink_rules, {
  regex = [[\b([A-Za-z0-9._\\/-]+\.[A-Za-z0-9]+):([0-9]+)\b]],
  format = 'file-line://$1:$2',
})

-- Ctrl-click on a file:line → open in Cursor at that exact position.
-- Relative paths are resolved against the clicked pane's cwd. Everything else
-- falls through to the default handler (browser).
wezterm.on('open-uri', function(window, pane, uri)
  local spec = uri:match('^file%-line://(.+)$')
  if not spec then return end
  if not spec:match('^%a:[/\\]') and not spec:match('^[/\\]') then
    local ok, cwd = pcall(function() return pane:get_current_working_dir() end)
    if ok and cwd and cwd.file_path then
      local base = cwd.file_path:gsub('^/(%a:)', '%1')  -- '/C:/x' → 'C:/x'
      spec = base .. '/' .. spec
    end
  end
  -- cursor is a .cmd shim on Windows; launch through cmd.exe.
  wezterm.background_child_process { 'cmd.exe', '/c', 'cursor', '--goto', spec }
  return false
end)

-- Leader key: injected from the saved config (default Ctrl+Space).
-- phys:Space matches the physical key — Ctrl+Space emits NUL on Windows, which a
-- logical ' ' match would miss (same reason pane_nav.lua uses phys:F*).
-- ~24h timeout = effectively no timeout (WezTerm has no 'infinite'): the leader
-- waits for input instead of silently expiring. The peach cursor + ⌨ LEADER badge
-- show it's pending; <leader> then Esc cancels (binding below).
config.leader = { key = '__LEADER_KEY__', mods = '__LEADER_MODS__', timeout_milliseconds = 86400000 }

-- Fuzzy-pick a domain (Alt+L style) and split it into the current pane.
-- direction is a wezterm SplitPane direction ('Right' or 'Down').
local function pick_domain_split(window, pane, direction)
  local choices = {}
  for _, d in ipairs(wezterm.mux.all_domains()) do
    table.insert(choices, { id = d:name(), label = d:name() })
  end
  table.sort(choices, function(a, b) return a.label < b.label end)
  window:perform_action(act.InputSelector {
    title = 'Split ' .. direction:lower() .. ' into domain',
    choices = choices,
    fuzzy = true,
    action = wezterm.action_callback(function(win, p, id)
      if not id then return end
      -- SplitPane has no `domain` field; SplitHorizontal/SplitVertical take a
      -- SpawnCommand whose `domain` selects the target domain.
      if direction == 'Right' then
        win:perform_action(act.SplitHorizontal { domain = { DomainName = id } }, p)
      else
        win:perform_action(act.SplitVertical { domain = { DomainName = id } }, p)
      end
    end),
  }, pane)
end

local WEZTERM_CLI = 'wezterm'

-- Close every pane in the current workspace (the "delete this workspace" gesture).
-- WezTerm has no Lua API to close a tab/workspace, so collect pane ids from the mux
-- and kill them via `wezterm cli`, after switching the GUI to another workspace so
-- WezTerm doesn't quit when the last window of the doomed workspace closes.
local function kill_workspace(window, pane)
  local target = window:active_workspace()
  local fallback
  for _, n in ipairs(wezterm.mux.get_workspace_names()) do
    if n ~= target then fallback = n break end
  end
  if not fallback then
    window:toast_notification('WezTerm', 'Cannot kill the only workspace', nil, 4000)
    return
  end
  window:perform_action(act.InputSelector {
    title = "Kill workspace '" .. target .. "'? (closes all its panes)",
    choices = { { id = 'yes', label = 'Yes, close all panes' }, { id = 'no', label = 'Cancel' } },
    action = wezterm.action_callback(function(win, p, id)
      if id ~= 'yes' then return end
      local ids = {}
      for _, w in ipairs(wezterm.mux.all_windows()) do
        if w:get_workspace() == target then
          for _, tab in ipairs(w:tabs()) do
            for _, pn in ipairs(tab:panes()) do table.insert(ids, tostring(pn:pane_id())) end
          end
        end
      end
      win:perform_action(act.SwitchToWorkspace { name = fallback }, p)
      for _, pid in ipairs(ids) do
        wezterm.run_child_process { WEZTERM_CLI, 'cli', 'kill-pane', '--pane-id', pid }
      end
    end),
  }, pane)
end

-- Status-bar detail toggle (Leader+s): show/hide the user@host + path segment
-- for the active pane. OFF by default — "you@host │ ~/some/path" is noise you
-- already know; the tab titles carry the per-pane context and the always-on
-- segments (Claude fleet and workspace; deliberately no clock) don't need it. Press Leader+s when
-- you actually need to see where a pane is.
-- wezterm.GLOBAL survives config reloads (a plain local would reset); it does
-- not survive a GUI restart, so every launch starts quiet.
if wezterm.GLOBAL.show_identity == nil then wezterm.GLOBAL.show_identity = false end

config.keys = {
  { key = 'l', mods = 'ALT', action = act.ShowLauncherArgs {
      flags = 'FUZZY|TABS|DOMAINS|LAUNCH_MENU_ITEMS|WORKSPACES|COMMANDS' } },
  { key = 'w', mods = 'LEADER', action = act.ShowLauncherArgs { flags = 'FUZZY|WORKSPACES' } },
  { key = 'n', mods = 'LEADER', action = act.PromptInputLine {
      description = 'New/switch workspace:',
      action = wezterm.action_callback(function(window, pane, line)
        if line and #line > 0 then
          window:perform_action(act.SwitchToWorkspace { name = line }, pane)
        end
      end) } },
  -- Workspace management: R = rename, X = kill (close every pane in it).
  { key = 'R', mods = 'LEADER', action = act.PromptInputLine {
      description = 'Rename workspace to:',
      action = wezterm.action_callback(function(window, pane, line)
        if line and #line > 0 then
          wezterm.mux.rename_workspace(window:active_workspace(), line)
        end
      end) } },
  { key = 'X', mods = 'LEADER', action = wezterm.action_callback(kill_workspace) },
  -- Local splits: h = top/bottom (stacked), v = left/right (side-by-side).
  { key = 'h', mods = 'LEADER', action = act.SplitVertical   { domain = 'CurrentPaneDomain' } },
  { key = 'v', mods = 'LEADER', action = act.SplitHorizontal { domain = 'CurrentPaneDomain' } },
  -- Domain splits (Shift = "remote"): H = pick domain → top/bottom, V = pick domain → left/right.
  { key = 'H', mods = 'LEADER', action = wezterm.action_callback(function(w, p) pick_domain_split(w, p, 'Down') end) },
  { key = 'V', mods = 'LEADER', action = wezterm.action_callback(function(w, p) pick_domain_split(w, p, 'Right') end) },
  -- Toggle the status-bar detail (workspace + user@host + path); off by default.
  -- Toggle the TTS mute without leaving the keyboard. Fire-and-forget: the EXE writes
  -- the sentinel that this config polls, so the chip follows within a second.
  { key = 'm', mods = 'LEADER', action = wezterm.action_callback(function(window, pane)
    local base = os.getenv('LOCALAPPDATA')
    if not base then
      window:toast_notification('terminal-stack', 'TTS mute is Windows-only here', nil, 3000)
      return
    end
    local exe = base .. '\\terminal-stack\\tts-daemon\\terminal-stack-tts.exe'
    local ok = pcall(wezterm.background_child_process, { exe, 'mute' })
    if not ok then
      window:toast_notification('terminal-stack', 'terminal-stack-tts.exe not found', nil, 3000)
    end
  end) },
  { key = 's', mods = 'LEADER', action = wezterm.action_callback(function(window)
      wezterm.GLOBAL.show_identity = not wezterm.GLOBAL.show_identity
    end) },
  -- Arrow-driven pane control. Each does its first action AND enters a repeatable
  -- mode (key_tables below); inside a mode, plain arrows or j/k/i/m repeat.
  -- Move = Leader+Arrow · Resize = Leader+Shift+Arrow · Rotate = Leader+Ctrl+←/→.
  { key = 'LeftArrow',  mods = 'LEADER', action = act.Multiple { act.ActivatePaneDirection 'Left',  act.ActivateKeyTable { name = 'move_mode', one_shot = false, until_unknown = true, timeout_milliseconds = 1000 } } },
  { key = 'RightArrow', mods = 'LEADER', action = act.Multiple { act.ActivatePaneDirection 'Right', act.ActivateKeyTable { name = 'move_mode', one_shot = false, until_unknown = true, timeout_milliseconds = 1000 } } },
  { key = 'UpArrow',    mods = 'LEADER', action = act.Multiple { act.ActivatePaneDirection 'Up',    act.ActivateKeyTable { name = 'move_mode', one_shot = false, until_unknown = true, timeout_milliseconds = 1000 } } },
  { key = 'DownArrow',  mods = 'LEADER', action = act.Multiple { act.ActivatePaneDirection 'Down',  act.ActivateKeyTable { name = 'move_mode', one_shot = false, until_unknown = true, timeout_milliseconds = 1000 } } },
  { key = 'LeftArrow',  mods = 'LEADER|SHIFT', action = act.Multiple { act.AdjustPaneSize { 'Left',  3 }, act.ActivateKeyTable { name = 'resize_mode', one_shot = false, until_unknown = true, timeout_milliseconds = 1500 } } },
  { key = 'RightArrow', mods = 'LEADER|SHIFT', action = act.Multiple { act.AdjustPaneSize { 'Right', 3 }, act.ActivateKeyTable { name = 'resize_mode', one_shot = false, until_unknown = true, timeout_milliseconds = 1500 } } },
  { key = 'UpArrow',    mods = 'LEADER|SHIFT', action = act.Multiple { act.AdjustPaneSize { 'Up',    3 }, act.ActivateKeyTable { name = 'resize_mode', one_shot = false, until_unknown = true, timeout_milliseconds = 1500 } } },
  { key = 'DownArrow',  mods = 'LEADER|SHIFT', action = act.Multiple { act.AdjustPaneSize { 'Down',  3 }, act.ActivateKeyTable { name = 'resize_mode', one_shot = false, until_unknown = true, timeout_milliseconds = 1500 } } },
  { key = 'LeftArrow',  mods = 'LEADER|CTRL', action = act.Multiple { act.RotatePanes 'CounterClockwise', act.ActivateKeyTable { name = 'rotate_mode', one_shot = false, until_unknown = true, timeout_milliseconds = 1500 } } },
  { key = 'RightArrow', mods = 'LEADER|CTRL', action = act.Multiple { act.RotatePanes 'Clockwise', act.ActivateKeyTable { name = 'rotate_mode', one_shot = false, until_unknown = true, timeout_milliseconds = 1500 } } },
  -- Repeatable tab-switch (Leader+t) and font-size (Leader+f) modes.
  { key = 't', mods = 'LEADER', action = act.ActivateKeyTable { name = 'tab_mode', one_shot = false, until_unknown = true, timeout_milliseconds = 1500 } },
  { key = 'f', mods = 'LEADER', action = act.ActivateKeyTable { name = 'font_mode', one_shot = false, until_unknown = true, timeout_milliseconds = 1500 } },
