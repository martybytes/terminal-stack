<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  AGENTMEMORY_SECRET for GUI-launched agents. Managed by terminal-stack; edit
  Library/LaunchAgents/... in the clone, not this file.

  Cursor and Codex Desktop are launched by launchd, not by a shell. They inherit
  launchd's environment and read neither ~/.zshenv nor ~/.zshrc, so the shell
  block that covers terminal agents and hook subprocesses cannot reach them --
  their MCP clients expand ${AGENTMEMORY_SECRET} to empty and every request 401s,
  silently, because retrieval discards a non-2xx response.

  `launchctl setenv` alone would do it, but it is session-scoped and evaporates
  at logout. RunAtLoad makes it happen every login instead.

  The value is READ from the 0600 cache, never written here: this file is
  world-readable, and the secret rotates whenever the container regenerates
  /data/.hmac. Embedding it would work until the next rotation and then 401 with
  the error swallowed -- 56 consecutive captures were lost that way on
  2026-08-21. It is also what check-capture.sh's fixed-string scan looks for.

  Exits 0 when the cache is absent: agentmemory not being set up yet is a normal
  state, not a login-time error worth a crash report.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.terminal-stack.agentmemory-secret</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>f="${XDG_CONFIG_HOME:-$HOME/.config}/terminal-stack/agentmemory.secret"; [ -r "$f" ] || exit 0; v=$(cat "$f") || exit 0; [ -n "$v" ] || exit 0; exec /bin/launchctl setenv AGENTMEMORY_SECRET "$v"</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <false/>
</dict>
</plist>
