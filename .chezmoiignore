# Exclude the Windows-side tree from chezmoi's normal apply; it's synced by run_after_90-sync-windows.sh
windows/**

# Repo-level docs and infrastructure (not user-config files)
README.md
ARCHITECTURE.md
CHANGELOG.md
INSTALL.md
CLAUDE.md
AGENTS.md
REVAMP-PLAN.md
pyproject.toml
LICENSE
.gitignore
.gitattributes
.github/**
bootstrap/**
docs/**
context/**
# The pytest suite is repo infrastructure, run from the clone. Without this it
# maps to ~/tests/** and litters $HOME with the test files — same trap the
# installer entry points below fell into.
tests/**
# The absorbed service tree: compose files, per-stack helper scripts, and the
# console's source. None of it is a user-config file, and .chezmoiignore is
# allow-by-default, so without this line every one of ~160 files is written into
# $HOME on apply (services/stacks/kokoro/README.md -> ~/services/stacks/...) —
# the same trap tests/** and the installer entry points fell into.
#
# ONE line, deliberately: a stack is discovered by finding a compose file, with
# nothing to register anywhere. A per-stack list here would reintroduce a
# mandatory registration step whose failure mode is silent $HOME pollution.
services/**
# The pre-commit hook is repo infrastructure, run from a DEV clone, never $HOME.
.githooks/**
# Project-scoped Claude Code commands: dev-clone infrastructure. Without this
# line chezmoi deploys them to ~/.claude/commands and they collide with the
# user's own global commands.
.claude/**
# The tstack program: repo infrastructure, run from the clone by the shell shims in
# dot_zshrc and $PROFILE. Same allow-by-default trap as tests/** and services/**:
# without this line every module is written into $HOME on apply
# (tstack/commands/config.py -> ~/tstack/commands/config.py).
tstack/**
# Python bytecode caches are build noise. .gitignore already covers them, but
# chezmoi has its own ignore list — without this, running the codex hook tests
# deploys ~/.codex/hooks/__pycache__/*.pyc.
**/__pycache__/**
.pytest_cache/**
# Installer entry points + Windows sync script live at the repo root for the
# raw-URL one-liners; they are run from the clone, never deployed to $HOME.
# Without these, chezmoi maps them to ~/install-linux.sh, ~/scripts/…, etc.
install-linux.sh
install-mac.sh
install-wsl.sh
install.ps1
scripts/**

# WezTerm GUI config — applied on macOS only. Native Linux hosts in this stack
# are headless (ssh/PuTTY); Windows gets windows/.wezterm.lua via the sync hook.
# .wezterm/** covers the Lua modules (pane_nav.lua) — without the gate they'd
# litter WSL/native-Linux home dirs with a module nothing requires.
{{ if ne .chezmoi.os "darwin" }}
.wezterm.lua
.wezterm/**
.config/ghostty/**
{{ end }}
{{- /* Ghostty config, off switch. Two independent gates: the darwin one above
       (this path is chezmoi's, and chezmoi only manages $HOME here; the WINDOWS
       Ghostty config is a different file, windows/AppData/Local/ghostty/, carried
       by the sync — native-Linux hosts are headless and get neither),
       and this one, which is how `tstack config ghostty off` stops the config being
       re-rendered. Turning it off does NOT delete anything from $HOME — that is
       tstack config's job, deliberately, because .chezmoiignore is evaluated on
       every machine and a removal rule would wipe a hand-written Ghostty config
       on a box that never opted in. */}}
{{ if ne (index . "ghosttyConfig" | default "on") "on" }}
.config/ghostty/**
{{ end }}
