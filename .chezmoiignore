# The absorbed service tree: compose files, per-stack helper scripts, and the
# console's source. None of it is a user-config file, and .chezmoiignore is
# allow-by-default, so without this line every one of ~160 files is written into
# $HOME on apply (services/stacks/kokoro/README.md -> ~/services/stacks/...) —
# the same trap tests/** and the installer entry points fell into.
#
# ONE line, deliberately: a stack is discovered by finding a compose file, with
# nothing to register anywhere. A per-stack list here would reintroduce a
# mandatory registration step whose failure mode is silent $HOME pollution.
services/**
# The pre-commit hook is repo infrastructure, run from a DEV clone, never $HOME.
.githooks/**
# NOTE: there is deliberately NO `.claude/**` rule here.
#
# There used to be, to stop the repo's own project-scoped `.claude/commands`
# reaching ~/.claude. It did that -- and, because .chezmoiignore matches the
# TARGET path and `dot_claude/` maps to the same target, it also blocked the
# entire `dot_claude/**` tree. statusLine, the hooks, keybindings, skills, tts
# and modify_settings.json have therefore never deployed on any POSIX machine.
# Found by installing on a throwaway account: `chezmoi managed | grep claude`
# returned nothing but the two run_ scripts, and ~/.claude did not exist.
#
# The rule was never needed. chezmoi ignores source entries whose name begins
# with a dot on its own; proved in a container with no .chezmoiignore at all,
# where `chezmoi managed` listed `.claude/statusline.sh` (from dot_claude/) and
# did NOT list the repo's own `.claude/commands/`. Pinned by
# test_the_claude_tree_is_not_ignored in tests/test_agent_tools.py.

# A stray committed fixture, not a config file. `C/ts-agentmemory-data.tgz` came
# in with a services test and had no rule, so every POSIX apply created ~/C/ and
# put a tarball in it. Same allow-by-default trap as tests/**, services/** and
# tstack/** above, arriving by the same door.
C
C/**
# The tstack program: repo infrastructure, run from the clone by the shell shims in
# dot_zshrc and $PROFILE. Same allow-by-default trap as tests/** and services/**:
# without this line every module is written into $HOME on apply
# (tstack/commands/config.py -> ~/tstack/commands/config.py).
tstack/**
# Backups of SOURCE files. The repo's convention is to write <path>.bak.YYYYMMDD
# before overwriting a user file, and .gitignore's `*.bak.*` means git never
# reports one -- so a backup taken against a file in this tree is invisible to
# `git status` AND to the dirty-clone guards that read it. chezmoi has no such
# rule, so `dot_zshrc.bak.20260827204438` became a source entry and the next
# apply would have written ~/.zshrc.bak.20260827204438 into $HOME and kept
# writing it forever. Same trap as tests/** and services/**, arriving by a
# different door: not a file someone added, but one a helper left behind.
*.bak
*.bak.*

# Python bytecode caches are build noise. .gitignore already covers them, but
# chezmoi has its own ignore list — without this, running the codex hook tests
# deploys ~/.codex/hooks/__pycache__/*.pyc.
**/__pycache__/**
.pytest_cache/**
# Installer entry points + Windows sync script live at the repo root for the
# raw-URL one-liners; they are run from the clone, never deployed to $HOME.
# Without these, chezmoi maps them to ~/install-linux.sh, ~/scripts/…, etc.
install-linux.sh
install-mac.sh
install-wsl.sh
install.ps1
scripts/**

{{- /* tmux: ONE of the two paths, never both.

       tmux reads ~/.tmux.conf OR $XDG_CONFIG_HOME/tmux/tmux.conf, and on tmux
       3.7c the XDG file wins when both exist. Omarchy ships its own config at
       the XDG path, so on Omarchy the stack must write THERE -- writing
       ~/.tmux.conf produced a file tmux never read, which is worse than no file
       at all because `chezmoi diff` shows it landing.

       Everywhere else keeps ~/.tmux.conf: it is what every other platform in
       this stack already has, and moving it would be a change with no cause. */ -}}
{{ if eq (index . "distroId" | default "") "omarchy" }}
.tmux.conf
{{ else }}
.config/tmux/**
{{ end }}

{{- /* WezTerm GUI config. macOS, and now Omarchy.

       The old comment here said "native Linux hosts in this stack are headless
       (ssh/PuTTY)", and that premise died with Omarchy: it is a Hyprland desktop
       with wezterm in `extra`, and the flagship config -- pane_nav, the
       hand-rolled tab bar, the Claude fleet counts -- was the one thing the
       stack did not deploy there.

       Gated on the DISTRO rather than on "is this graphical", deliberately.
       There is no reliable graphical signal at apply time: WAYLAND_DISPLAY is
       absent when chezmoi runs from a hook or over ssh, and probing for a
       compositor socket would make the file appear and disappear depending on
       whether anyone happened to be logged in. Omarchy is a desktop by
       definition, which makes this deterministic. Generic graphical Linux needs
       the bootstrap's headless answer persisted first; see docs/omarchy.md.

       Windows gets windows/.wezterm.lua through the sync hook, not this. */ -}}
{{ if and (ne .chezmoi.os "darwin") (ne (index . "distroId" | default "") "omarchy") }}
.wezterm.lua
.wezterm/**
{{ end }}
{{ if ne .chezmoi.os "darwin" }}
.config/ghostty/**
{{- /* ~/Library/LaunchAgents is a macOS path. On WSL the GUI agents are WINDOWS
       processes and inherit HKCU\Environment, which the plugin's own setup
       writes; on native Linux this stack installs no GUI agent at all. Both the
       directory AND its contents: naming only `Library/**` still creates an
       empty ~/Library/LaunchAgents. */}}
Library
Library/**
{{ end }}
{{- /* The LaunchAgent exists to put AGENTMEMORY_SECRET into the launchd
       environment that Cursor and Codex Desktop inherit. With agentmemory off
       there is no secret to export, and a login job that reads a file nobody
       writes is worse than no job: it is a thing to explain later. Removal is
       chezmoi's here (unlike the Ghostty config, which a user may have written
       by hand) because nothing but this stack ever creates this plist. */}}
{{ if ne (index . "agentmemoryEnabled" | default "off") "on" }}
Library
Library/**
{{ end }}
{{- /* Ghostty config, off switch. Two independent gates: the darwin one above
       (macOS is the only Ghostty this stack configures — the Windows target went
       with noctty, and native-Linux hosts are headless),
       and this one, which is how `tstack config ghostty off` stops the config being
       re-rendered. Turning it off does NOT delete anything from $HOME — that is
       tstack config's job, deliberately, because .chezmoiignore is evaluated on
       every machine and a removal rule would wipe a hand-written Ghostty config
       on a box that never opted in. */}}
{{ if ne (index . "ghosttyConfig" | default "on") "on" }}
.config/ghostty/**
{{ end }}
