#!/usr/bin/env python3
"""Splice the stack-owned keys of this template into the live ~/.claude/settings.json
instead of replacing the file. POSIX twin of bootstrap/_merge_claude_settings.ps1
(Windows); keep the two ownership rules identical.

Why this is a modify_ script and not a plain chezmoi target: Claude Code WRITES
this same file. `model`, `enabledPlugins`, `permissions`, `env`,
`agentPushNotifEnabled` and friends are its own state, set from the Claude UI,
not ours — and a whole-file target silently deletes every one of them with
nothing in the diff to explain it. That is how the agentmemory plugin got
disabled on the Windows side on 2026-08-20, and `docs/decisions.md` §"Why
`~/.claude/settings.json` is spliced, not copied" called this exact day: "The
WSL-side dot_claude/settings.json.tmpl is still a whole-file chezmoi target.
That is correct only as long as WSL-side Claude Code has no plugins and no
per-machine keys; the day it does, it needs a modify_ script doing the same
splice."

Ownership is derived from the rendered fragment below, NOT a hard-coded list —
so dropping a key from the template drops it from the live file, and adding one
takes it over. Everything else in the live file survives byte for byte.

`theme` is dropped on Omarchy, and only there. `omarchy-theme-set-claude
--activate` writes "custom:omarchy" and keeps ~/.claude/themes/omarchy.json in
step with the active desktop theme, which Claude Code hot-reloads. A flat
light/dark token written over the top of that flaps between the two on every
apply and every `omarchy theme set`, with nothing to explain it. statusLine and
hooks stay ours on every platform; only this one key is ceded.

`hooks` is owned per ENTRY, not per key. Other tools write their own hooks into
this same object: `herdr integration install claude` adds SessionStart,
PreToolUse, Stop and friends calling ~/.claude/hooks/herdr-agent-state.sh, and
that is all herdr's agents panel has to go on. Splicing the `hooks` VALUE
wholesale deleted them on every `tstack update` -- the panel went empty, with
nothing in the diff to say why. So each event array is rebuilt as *our rendered
groups, then every group that was already there with our hooks taken out*. An
inner hook is ours if its command references one of MARKERS, or if it is
identical to one we render now; a group someone else appended into keeps their
hook. An event that ends up empty disappears, which is how turning TTS off still
removes ours. Same rule as dot_cursor/modify_hooks.json.tmpl, one level deeper
because Claude nests `{matcher, hooks: [...]}`. docs/decisions.md § "Why
`~/.claude/settings.json` is spliced, not copied".

Keep the rationale HERE rather than as a `{{/* … */}}` comment inside the JSON
fragment: tests/test_agent_tools.py renders this template crudely (strip the
`if`/`end` directives, substitute the rest) and a template comment came back as
a literal in the middle of the object.

And note what the splice does NOT do: chezmoi writes the result, and chezmoi
writes a REGULAR FILE. Where the target is a symlink — omarchy-dots stows this
file — the link is replaced and the tracked file is orphaned. That is repaired
either side of the apply by run_before_25-claude-settings-link-record.sh and
run_after_25-claude-settings-link-restore.sh, not here: this script only
produces bytes.

chezmoi hands us the current target contents on stdin and takes stdout as the
new contents. We refuse rather than guess: if the live file is present but
unparseable, we echo it back untouched instead of destroying hand-edits.
"""
import json
import os
import sys
from collections import OrderedDict

# The stack-owned fragment. chezmoi renders this before the script runs.
FRAGMENT = r"""
{
  "statusLine": {
    "type": "command",
    "command": "bash {{ .chezmoi.homeDir }}/.claude/statusline-command.sh"
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir }}/.claude/hooks/wez-tab-status.sh thinking"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir }}/.claude/hooks/wez-tab-status.sh working"
          }
        ]
      }{{ if eq (index . "ccTtsEnabled" | default "false") "true" }},
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir }}/.claude/hooks/cc-speak-input.sh question"
          }
        ]
      }{{ end }}
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir }}/.claude/hooks/wez-tab-status.sh waiting"
          }{{ if eq (index . "ccTtsEnabled" | default "false") "true" }},
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir }}/.claude/hooks/cc-speak.sh waiting"
          }{{ end }}
        ]
      }
    ],
    "StopFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir }}/.claude/hooks/wez-tab-status.sh error"
          }{{ if eq (index . "ccTtsEnabled" | default "false") "true" }},
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir }}/.claude/hooks/cc-speak.sh error"
          }{{ end }}
        ]
      }
    ]{{ if eq (index . "ccTtsEnabled" | default "false") "true" }},
    "Notification": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir }}/.claude/hooks/cc-speak-input.sh notification"
          }
        ]
      }
    ]{{ end }}
  }{{ if ne (index . "distroId" | default "") "omarchy" }},
  "theme": "{{ if hasKey . "resolvedTheme" }}{{ .resolvedTheme }}{{ else }}dark{{ end }}"{{ end }}
}
"""


# Every command this stack has ever written into the `hooks` object, on any
# platform. Same list as bootstrap/_merge_claude_settings.ps1. Never `.claude/hooks/`
# on its own: herdr's herdr-agent-state.sh lives in that directory too.
MARKERS = (
    "wez-tab-status",  # .claude/hooks/wez-tab-status.sh / .ps1
    "cc-speak",  # .claude/hooks/cc-speak.sh, cc-speak-input.sh
    "cc-tts",  # .claude/hooks/cc-tts-*.sh
    "terminal-stack-tts",  # Windows: tts-daemon/terminal-stack-tts.exe hook ...
)


def canonical(value):
    return json.dumps(value, sort_keys=True, separators=(",", ":"))


def is_ours(hook, rendered):
    command = hook.get("command", "") if isinstance(hook, dict) else ""
    if not isinstance(command, str):
        command = ""
    if any(marker in command for marker in MARKERS):
        return True
    canon = canonical(hook)
    return any(canonical(r) == canon for r in rendered)


def inner_hooks(groups):
    out = []
    for group in groups:
        if isinstance(group, dict) and isinstance(group.get("hooks"), list):
            out.extend(group["hooks"])
    return out


def as_list(value):
    if value is None:
        return []
    return value if isinstance(value, list) else [value]


def merge_hooks(live_hooks, rendered_hooks):
    if not isinstance(rendered_hooks, dict):
        rendered_hooks = OrderedDict()
    if not isinstance(live_hooks, dict):
        live_hooks = OrderedDict()
    events = list(live_hooks.keys())
    events += [ev for ev in rendered_hooks if ev not in live_hooks]
    result = OrderedDict()
    for event in events:
        ours = as_list(rendered_hooks.get(event))
        rendered_inner = inner_hooks(ours)
        foreign = []
        for group in as_list(live_hooks.get(event)):
            if not isinstance(group, dict) or not isinstance(group.get("hooks"), list):
                # Not a shape we write; leave it exactly as found.
                foreign.append(group)
                continue
            kept = [h for h in group["hooks"] if not is_ours(h, rendered_inner)]
            if len(kept) == len(group["hooks"]):
                foreign.append(group)
            elif kept:
                # Someone appended into a group we wrote: theirs survives.
                trimmed = OrderedDict(group)
                trimmed["hooks"] = kept
                foreign.append(trimmed)
        entries = list(ours) + foreign
        if entries:
            result[event] = entries
    return result


def emit(text):
    # Binary, not sys.stdout.write: text mode translates \n on the way out, so
    # on a CRLF host every apply adds a \r that the next apply reads back and
    # doubles. This script's contract is that only OUR keys change; the bytes it
    # writes are part of that.
    sys.stdout.buffer.write(text.encode("utf-8"))
    raise SystemExit(0)


live_raw = sys.stdin.read()
fragment = json.loads(FRAGMENT, object_pairs_hook=OrderedDict)

# No live file yet (fresh machine): nothing to preserve, so the fragment IS the file.
if not live_raw.strip():
    emit(json.dumps(fragment, indent=2) + "\n")

try:
    live = json.loads(live_raw, object_pairs_hook=OrderedDict)
except ValueError as exc:
    # Refuse rather than guess. Echoing the input back is a no-op apply; a
    # destroyed hand-edit would not be recoverable.
    sys.stderr.write(
        "modify_settings.json: live ~/.claude/settings.json is not valid JSON "
        "(%s); leaving it untouched.\n" % exc
    )
    emit(live_raw)

if not isinstance(live, dict):
    sys.stderr.write(
        "modify_settings.json: live ~/.claude/settings.json is not a JSON object; "
        "leaving it untouched.\n"
    )
    emit(live_raw)

# Splice: overwrite the keys the fragment renders, in place, and append any it
# adds -- except `hooks`, merged per entry below. Every other key, and the live
# file's key order, is preserved.
merged = OrderedDict(live)
for key, value in fragment.items():
    if key == "hooks":
        merged[key] = merge_hooks(live.get("hooks"), value)
    else:
        merged[key] = value

emit(json.dumps(merged, indent=2) + "\n")
