# Rendered by chezmoi from the saved `atuinEnabled` setting; sourced by
# dot_zshrc's cli-tools block. When the setting is "off" this file is empty,
# which is the whole point: the atuin binary is often installed but dormant
# (a brew dependency, an old manual install), so a `command -v atuin` guard in
# dot_zshrc would hijack Ctrl+R without anyone choosing it.
#
# Change with `ts-config atuin on|off` — do not edit this file, chezmoi
# overwrites it on every apply.
{{ if eq (index . "atuinEnabled" | default "off") "on" -}}
# --disable-up-arrow: Up stays with oh-my-zsh's up-line-or-beginning-search
# (prefix search), which is long-standing muscle memory. Ctrl+R goes to atuin;
# fzf keeps Ctrl+T and Alt+C. Still command -v guarded so a machine where the
# install failed degrades to fzf rather than erroring on every new shell.
command -v atuin >/dev/null 2>&1 && eval "$(atuin init zsh --disable-up-arrow)"
{{- end }}
