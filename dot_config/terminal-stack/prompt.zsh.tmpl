# Rendered by chezmoi from the saved prompt settings; sourced by dot_zshrc's
# starship block, which owns the logic. This file only carries the values, so
# dot_zshrc stays a plain file (`chezmoi re-add ~/.zshrc` keeps working).
#
# Change with `tstack config prompt transient on|off|bare|dir|time|dir-time` —
# do not edit this file, chezmoi overwrites it on every apply. For one shell
# only, export TS_PROMPT_TRANSIENT / TS_PROMPT_TRANSIENT_STYLE before it starts:
# the environment wins over the saved value.
: ${TS_PROMPT_TRANSIENT:={{ index . "promptTransient" | default "on" }}}
: ${TS_PROMPT_TRANSIENT_STYLE:={{ index . "promptTransientStyle" | default "bare" }}}
