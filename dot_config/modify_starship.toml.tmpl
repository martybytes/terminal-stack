#!/usr/bin/env bash
# modify_starship.toml — render this stack's prompt WITHOUT throwing away the one
# that was already there.
#
# chezmoi hands a modify_ script the current target on stdin and installs
# whatever it writes to stdout. A plain whole-file target replaced
# ~/.config/starship.toml outright, and on Omarchy that file is not empty: the
# distro ships its own 32-line prompt to every account through /etc/skel. Losing
# it silently is the same failure this repo already splices around for
# ~/.zshenv and ~/.claude/settings.json.
#
# So: the stack's prompt is written first, and everything that was in the file
# before is kept underneath it, commented out.
#
# CAPTURED ONCE, NOT ON EVERY APPLY. An apply runs repeatedly, so the naive
# version comments its own output back into itself and the file grows without
# bound. The marker below is what prevents that: if the incoming file already
# carries it, the preserved block is reused verbatim and nothing new is
# captured. Only the FIRST apply -- the one that sees somebody else's file --
# takes a copy.
#
# To restore what was there: uncomment the block, or read it as a record of what
# the machine looked like before the stack arrived.
set -eu

MARK_START='# ---- terminal-stack: the starship.toml that was here before ----'
MARK_END='# ---- end of preserved original ----'

current="$(cat)"

{{/* NO leading `{{-` and NO trailing `-}}` on this line. A leading dash trims
     BACKWARDS across the newline and glues the heredoc opener below onto the
     previous statement -- `current="$(cat)"config=$(cat <<'X'` -- so `config`
     is never assigned and the script dies on `set -u`. Measured: chezmoi
     rendered exactly that, and every apply failed with
     "line 214: config: unbound variable". The `{{ if ... -}}` below is where
     the forward trim belongs, so the assignment starts at column 0. */}}
{{ $preset := index . "starshipPreset" | default "terminal-stack" }}
{{ if and (ne $preset "terminal-stack") (lookPath "starship") -}}
config=$(cat <<'TS_STARSHIP_BODY'
# Starship's built-in "{{ $preset }}" preset, rendered by `starship preset` at
# apply time. Managed by terminal-stack: edits here are replaced on the next
# apply. To go back to this stack's own prompt: tstack config prompt terminal-stack
{{ output "starship" "preset" $preset }}
TS_STARSHIP_BODY
)
{{ else -}}
config=$(cat <<'TS_STARSHIP_BODY'
"$schema" = "https://starship.rs/config-schema.json"

# Powerlevel10k Rainbow-style two-line prompt rebuilt in Starship.
# Reference: context/bestprompt.jpg (reference screenshot, 2026-05).
# Top line: ╭─ os · cwd · git-branch · git-status · ……… · user@host · clock · ─╮
# Bottom line: ╰─ ❯
#
# Glyph requirements: any Nerd Font (JetBrainsMono Nerd Font is the stack default).
# Nerd Font glyphs use \u escapes — the Private-Use-Area characters (U+E000–U+F8FF)
# are not safe to paste literally because some editors silently strip them.
#
# Colours come from the `palette` selected below (Catppuccin Mocha = dark,
# VS Code Light Modern = light). The palette overrides the standard colour names
# used in the styles, so the prompt tracks the stack's theme. `palette` is baked at apply
# time from the saved config (themeMode/resolvedTheme); change it with
# `tstack config theme <dark|light|follow>`.
palette = "{{ if hasKey . "resolvedTheme" }}{{ .resolvedTheme }}{{ else }}dark{{ end }}"

add_newline      = true
command_timeout  = 1000

format = """
[╭─ ](bold black)\
$os\
$directory\
$git_branch\
$git_status\
$cmd_duration\
$fill\
$username\
[@](bold black)\
$hostname\
$time\
[ ─╮](bold black)
[╰─](bold blue)$character"""

# ── Prompt arrow (line 2) ─────────────────────────────────────────────────────
[character]
success_symbol = "[❯](bold blue)"
error_symbol   = "[❯](bold red)"
vimcmd_symbol  = "[❮](bold blue)"

# ── OS icon (distro/platform logo, Nerd Font) ─────────────────────────────────
[os]
disabled = false
format   = "[$symbol ](bold blue)"

[os.symbols]
Alpine           = "\uf300"
Arch             = "\uf303"
CentOS           = "\uf304"
Debian           = "\uf306"
Fedora           = "\uf30a"
Linux            = "\uf17c"
Macos            = "\uf179"
Manjaro          = "\uf312"
Mint             = "\uf30e"
NixOS            = "\uf313"
openSUSE         = "\uf314"
Pop              = "\uf32a"
Raspbian         = "\uf315"
Redhat           = "\uf316"
RedHatEnterprise = "\uf316"
Ubuntu           = "\uf31b"
Unknown          = "\uf059"
Windows          = "\uf17a"

# ── Current directory (folder glyph + path) ───────────────────────────────────
[directory]
format            = "[ \uf07b $path]($style)"
style             = "bold blue"
truncation_length = 4
truncate_to_repo  = false
read_only         = " \uf023"
# Both of these are taken from Omarchy's own starship.toml, which is worth
# keeping rather than discarding wholesale.
#
# truncation_symbol: without it, `truncation_length = 4` silently drops the
# leading path components with nothing to show it happened -- you cannot tell a
# short path from a truncated one.
truncation_symbol = "…/"
# repo_root_*: inside a git repo, render the repo name distinctly from the path
# within it. Bold for the root, plain for the rest -- the palette has no second
# blue (cyan is the same hex), so weight carries the distinction.
repo_root_style   = "bold blue"
repo_root_format  = "[ \uf07b $repo_root]($repo_root_style)[$path](blue)[$read_only]($read_only_style)"

# ── Git branch (octocat + branch glyph + name) ────────────────────────────────
[git_branch]
format = "[ \uf09b $symbol $branch]($style)"
symbol = "\ue0a0"
style  = "bold green"

# ── Git status (modified/untracked/etc., yellow) ──────────────────────────────
[git_status]
format     = " [$all_status$ahead_behind]($style)"
style      = "bold yellow"
ahead      = "⇡${count} "
behind     = "⇣${count} "
diverged   = "⇕⇡${ahead_count}⇣${behind_count} "
conflicted = "= "
untracked  = "?${count} "
modified   = "!${count} "
staged     = "+${count} "
renamed    = "»${count} "
deleted    = "✘${count} "
stashed    = "≡ "

# ── Dots fill between left and right segments ─────────────────────────────────
[fill]
symbol = "."
style  = "bold black"

# ── User @ host ───────────────────────────────────────────────────────────────
[username]
show_always = true
format      = "[$user]($style)"
style_user  = "bold black"
style_root  = "bold red"

[hostname]
ssh_only = false
format   = "[$hostname]($style)"
style    = "bold blue"

# ── Clock ─────────────────────────────────────────────────────────────────────
[time]
disabled    = false
format      = " [\uf017 $time]($style)"
time_format = "%r"
style       = "bold black"

# ── Misc ──────────────────────────────────────────────────────────────────────
[cmd_duration]
min_time = 500
format   = " [\uf252 $duration]($style)"

[aws]
disabled = true
[gcloud]
disabled = true
[azure]
disabled = true

# ── Palettes ──────────────────────────────────────────────────────────────────
# These redefine the standard colour names used above, so selecting a palette
# (top of file) re-themes the whole prompt. dark = Catppuccin Mocha;
# light = VS Code Light Modern (terminal + light_plus syntax tokens).
[palettes.dark]
blue   = "#89b4fa"
green  = "#a6e3a1"
cyan   = "#89b4fa"
yellow = "#f9e2af"
red    = "#f38ba8"
black  = "#585b70"

[palettes.light]
blue   = "#005fb8"
green  = "#098658"
cyan   = "#005fb8"
yellow = "#949800"
red    = "#CD3131"
black  = "#616161"
TS_STARSHIP_BODY
)
{{ end -}}

# The preserved block. Reused if we have already taken it, captured if not.
if printf '%s\n' "$current" | grep -qF -- "$MARK_START"; then
    # Ours already. Take the block back out unchanged -- re-commenting it would
    # add a `# ` to every line on every apply.
    preserved="$(printf '%s\n' "$current" \
        | awk -v s="$MARK_START" -v e="$MARK_END" \
              'index($0, s) { f = 1 } f { print } index($0, e) { f = 0 }')"
elif [ -n "${current//[[:space:]]/}" ]; then
    # Somebody else's file, and this is the first apply. Comment it whole.
    preserved="$MARK_START
# Everything below was your ~/.config/starship.toml before terminal-stack
# managed this file. It is inert; uncomment what you want back.
$(printf '%s\n' "$current" | sed 's/^/# /')
$MARK_END"
else
    # Fresh machine: no file, nothing to preserve, no empty block to explain.
    preserved=""
fi

printf '%s\n' "$config"
[ -n "$preserved" ] && printf '\n%s\n' "$preserved"
exit 0
